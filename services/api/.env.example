PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://jiangkong:jiangkong@localhost:5432/jiangkong
# Must match the private hash provisioned by
# scripts/ops/configure-operating-ledger-runtime-role.sh. Never commit a real value.
OPERATING_LEDGER_DB_WRITE_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# 独立的短效 selectionRef HMAC 密钥，不得与 JWT、下载或彼此复用。
FUND_EXECUTION_BANK_OBSERVATION_SELECTION_SECRET=replace-with-an-independent-random-secret-of-at-least-32-characters
FUND_EXECUTION_AXIS_BUSINESS_SELECTION_SECRET=replace-with-another-independent-random-secret-of-at-least-32-characters
JWT_ACCESS_SECRET=replace-with-long-random-secret
JWT_REFRESH_SECRET=replace-with-long-random-secret
FILE_DOWNLOAD_SECRET=replace-with-long-random-file-download-secret
# 新账号统一初始密码。仅在受控环境文件配置，绝不写入仓库或前端。
INITIAL_USER_TEMPORARY_PASSWORD=
FILE_STORAGE_DRIVER=local
COS_SECRET_ID=replace-with-tencent-cos-secret-id
COS_SECRET_KEY=replace-with-tencent-cos-secret-key
COS_BUCKET=replace-with-private-bucket
COS_REGION=ap-guangzhou

# LibreOffice executable used for DOCX -> PDF conversion.
DOC_CONVERTER_COMMAND=soffice

# Maximum private upload size: 100 MiB.
FILE_UPLOAD_MAX_BYTES=104857600

# Contract workbench cutover: release-a | maintenance | release-b-maintenance | release-b.
# Canary IDs are used only in release-b-maintenance; never use "*".
CONTRACT_CUTOVER_MODE=release-a
CONTRACT_CUTOVER_CANARY_USER_IDS=

# Global/module write freeze: off | all | modules.
# For modules mode, use an exact comma-separated subset of:
# account,approval,contract,expense,files,finance,master_data,operations,organization,payment,procurement,project,settlement
# Keep this empty for off/all. Never use "*".
OPERATIONAL_WRITE_FREEZE_MODE=off
OPERATIONAL_WRITE_FREEZE_MODULES=

# Fonts permitted in published contract layouts; install these on the conversion host.
DOC_ALLOWED_FONTS=Noto Sans CJK SC,宋体,仿宋,黑体

# Empty disables spot procurement for every project. Use confirmed comma-separated project IDs only; "*" is forbidden.
SPOT_PROCUREMENT_PILOT_PROJECT_IDS=
