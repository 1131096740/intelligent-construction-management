generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid())
  phone              String?   @unique
  name               String
  departmentId       String?
  wxOpenid           String?   @unique
  passwordHash       String?
  mustChangePassword Boolean   @default(true)
  lastLoginAt        DateTime?
  isActive           Boolean   @default(true)
  signatureFileId    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([departmentId])
}

// 我方公司主体字典：合同签订时选择其一，名称快照进合同。
model CompanyEntity {
  id                      String   @id @default(uuid())
  name                    String
  unifiedSocialCreditCode String?
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  parentId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model Position {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserPosition {
  id         String   @id @default(uuid())
  userId     String
  positionId String
  projectId  String?
  createdAt  DateTime @default(now())

  @@unique([userId, positionId, projectId])
}

model Project {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectMember {
  id          String   @id @default(uuid())
  projectId   String
  userId      String
  positionKey String
  createdAt   DateTime @default(now())

  @@unique([projectId, userId, positionKey])
}

model Contract {
  id                        String    @id @default(uuid())
  projectId                 String
  source                    String    @default("system")
  code                      String?   @unique
  name                      String
  counterparty              String
  companyEntityId           String?
  companyEntityName         String?
  contractTypeKey           String?
  ownerUserId               String?
  businessScenarioId        String?
  scenarioTemplateMappingId String?
  scenarioSnapshot          Json?
  temporaryCode             String?   @unique
  voidedAt                  DateTime?
  voidedReason              String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([businessScenarioId])
  @@index([scenarioTemplateMappingId])
}

model ContractVersion {
  id                        String    @id @default(uuid())
  contractId                String
  versionNo                 Int
  changeType                String
  status                    String
  amountCents               BigInt
  baseVersionId             String?
  supersedesVersionId       String?
  changeReason              String?
  changeDirection           String?
  changeAmountCents         BigInt?
  originalBaseAmountCents   BigInt?
  cumulativeIncreaseCents   BigInt    @default(0)
  cumulativeDecreaseCents   BigInt    @default(0)
  amountLimitType           String    @default("capped")
  effectiveAt               DateTime?
  businessTemplateVersionId String?
  layoutTemplateVersionId   String?
  draftRevision             Int       @default(1)
  pricingNature             String    @default("fixed_total")
  amountSource              String    @default("manual")
  amountAdjustmentReason    String?
  draftData                 Json
  templateSnapshot          Json
  clauseSnapshot            Json
  readinessSnapshot         Json?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@unique([contractId, versionNo])
  @@index([baseVersionId])
  @@index([supersedesVersionId])
}

model ContractTakeover {
  id                                    String                 @id @default(uuid())
  projectId                             String
  takeoverBatchId                       String?
  importRowNo                           Int?
  contractId                            String
  contractVersionId                     String                 @unique
  paymentTermsVersionId                 String
  takeoverLevel                         String
  suggestedTakeoverLevel                String?
  takeoverLevelAdjustmentReason         String?
  takeoverStatus                        String
  lifecycleStatus                       String
  signedAt                              DateTime
  historicalSettledCents                BigInt                 @default(0)
  historicalApprovalPendingPaymentCents BigInt                 @default(0)
  historicalApprovedPendingPaymentCents BigInt                 @default(0)
  historicalPaidCents                   BigInt                 @default(0)
  historicalProxyPaidCents              BigInt                 @default(0)
  historicalAdvancePaidCents            BigInt                 @default(0)
  historicalAdvanceDeductedCents        BigInt                 @default(0)
  historicalRetentionWithheldCents      BigInt                 @default(0)
  historicalRetentionReleasedCents      BigInt                 @default(0)
  otherConfirmedOccupancyCents          BigInt                 @default(0)
  balanceSourceSummary                  String?
  evidenceSummary                       String?
  takeoverCutoffDate                    DateTime?
  responsibleUserId                     String?
  reviewComment                         String?
  acceptanceConclusion                  String?
  createdByUserId                       String
  submittedByUserId                     String?
  submittedAt                           DateTime?
  confirmedByUserId                     String?
  confirmedAt                           DateTime?
  historicalBalanceConfirmedByUserId    String?
  historicalBalanceConfirmedAt          DateTime?
  createdAt                             DateTime               @default(now())
  updatedAt                             DateTime               @updatedAt
  takeoverBatch                         ContractTakeoverBatch? @relation(fields: [takeoverBatchId], references: [id])

  @@unique([takeoverBatchId, importRowNo])
  @@index([projectId, takeoverStatus])
  @@index([takeoverBatchId])
  @@index([contractId])
  @@index([contractVersionId])
}

model ContractTakeoverBatch {
  id                   String             @id @default(uuid())
  projectId            String
  batchNo              String
  status               String
  takeoverCutoffDate   DateTime
  responsibleUserId    String
  reviewComment        String
  acceptanceConclusion String
  importFingerprint    String
  totalRows            Int                @default(0)
  readyRows            Int                @default(0)
  blockedRows          Int                @default(0)
  warningRows          Int                @default(0)
  createdCount         Int                @default(0)
  skippedCount         Int                @default(0)
  createdByUserId      String
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  takeovers            ContractTakeover[]

  @@unique([projectId, batchNo])
  @@unique([projectId, importFingerprint])
  @@index([projectId, status])
}

model ContractTakeoverCorrection {
  id                String   @id @default(uuid())
  projectId         String
  takeoverId        String
  correctionType    String
  beforeSnapshot    Json
  afterSnapshot     Json
  reason            String
  responsibleUserId String
  attachmentFileId  String
  createdByUserId   String
  createdAt         DateTime @default(now())

  @@index([projectId, takeoverId, createdAt])
  @@index([takeoverId])
}

model PaymentTermsVersion {
  id                String   @id @default(uuid())
  contractId        String
  contractVersionId String
  versionNo         Int
  status            String
  originalText      String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([contractId, versionNo])
}

model PaymentTermsStage {
  id                            String   @id @default(uuid())
  paymentTermsVersionId         String
  name                          String
  stageType                     String   @default("progress")
  basis                         String
  ratioBps                      Int?
  fixedAmountCents              BigInt?
  triggerAnchor                 String   @default("settlement_effective")
  triggerEvent                  String
  dueDays                       Int
  advanceDeductionMode          String   @default("none")
  advanceDeductionRatioBps      Int?
  advanceDeductionStartRatioBps Int?
  requiresInvoice               Boolean  @default(false)
  allowsEarlyPayment            Boolean  @default(false)
  allowsInstallments            Boolean  @default(true)
  retentionBps                  Int?
  originalText                  String
  createdAt                     DateTime @default(now())
}

model ContractArchiveFile {
  id                String    @id @default(uuid())
  contractVersionId String
  fileId            String
  uploadedByUserId  String
  confirmedByUserId String?
  confirmedAt       DateTime?
  status            String
  createdAt         DateTime  @default(now())
}

model Settlement {
  id                          String   @id @default(uuid())
  projectId                   String
  contractId                  String
  contractVersionId           String
  paymentTermsVersionId       String
  code                        String   @unique
  periodLabel                 String
  status                      String
  amountCents                 BigInt
  finalCumulativeAmountCents  BigInt?
  payableAmountCents          BigInt
  paidAmountCents             BigInt   @default(0)
  sourceType                  String   @default("system")
  sourceTakeoverId            String?  @unique
  settlementTemplateVersionId String?
  isFinal                     Boolean  @default(false)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@index([settlementTemplateVersionId])
}

model SettlementLine {
  id                       String   @id @default(uuid())
  settlementId             String
  contractBillRowId        String?
  sourceType               String
  name                     String
  unit                     String?
  quantity                 Decimal? @db.Decimal(24, 6)
  unitPriceCents           BigInt?
  calculationMode          String   @default("legacy")
  contractQuantitySnapshot Decimal? @db.Decimal(24, 6)
  unitPriceSnapshot        Decimal? @db.Decimal(24, 6)
  taxRatePercentSnapshot   Decimal? @db.Decimal(9, 6)
  pricingModeSnapshot      String?
  amountCents              BigInt
  reason                   String?
  remark                   String?
  sortOrder                Int
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([settlementId, sortOrder])
  @@index([contractBillRowId])
}

model SettlementImport {
  id                          String    @id @default(uuid())
  projectId                   String
  contractVersionId           String
  settlementTemplateVersionId String?
  fileId                      String
  fileSha256                  String
  sourceRevision              String
  status                      String    @default("preview")
  preview                     Json
  result                      Json?
  createdByUserId             String
  appliedByUserId             String?
  appliedAt                   DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([projectId, createdAt])
  @@index([contractVersionId, createdAt])
  @@index([fileId])
  @@index([settlementTemplateVersionId])
}

model SettlementTemplate {
  id              String   @id @default(uuid())
  name            String
  code            String   @unique
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SettlementTemplateVersion {
  id                         String    @id @default(uuid())
  settlementTemplateId       String
  versionNo                  Int
  status                     String    @default("draft")
  draftRevision              Int       @default(1)
  xlsxFileId                 String
  compatibleContractTypeKeys String[]  @default([])
  compatibleAmountRoles      String[]  @default([])
  compatiblePricingModes     String[]  @default([])
  columnSchema               Json
  printRules                 Json
  evidenceRules              Json
  anomalyRules               Json
  inspectionReport           Json?
  inspectionRevision         Int?
  previewXlsxFileId          String?
  previewPdfFileId           String?
  submittedByUserId          String?
  publishedByUserId          String?
  publishedAt                DateTime?
  stoppedAt                  DateTime?
  changeSummary              String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@unique([settlementTemplateId, versionNo])
  @@index([status, publishedAt])
}

model SettlementTemplatePreviewJob {
  id                          String    @id @default(uuid())
  settlementTemplateVersionId String
  sourceRevision              Int
  status                      String    @default("queued")
  sampleData                  Json
  previewXlsxFileId           String?
  previewPdfFileId            String?
  errorMessage                String?
  createdByUserId             String
  startedAt                   DateTime?
  completedAt                 DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([settlementTemplateVersionId, createdAt])
}

model SettlementArchiveFile {
  id                String    @id @default(uuid())
  settlementId      String
  fileId            String
  uploadedByUserId  String
  confirmedByUserId String?
  confirmedAt       DateTime?
  status            String
  createdAt         DateTime  @default(now())
}

model PaymentRequest {
  id                    String    @id @default(uuid())
  projectId             String
  settlementId          String?
  sourceType            String    @default("settlement")
  contractId            String
  contractVersionId     String
  paymentTermsVersionId String
  code                  String    @unique
  status                String
  requestedAmountCents  BigInt
  approvedAmountCents   BigInt?
  paidAmountCents       BigInt    @default(0)
  dueDate               DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model PaymentExecution {
  id               String   @id @default(uuid())
  paymentRequestId String
  settlementId     String?
  amountCents      BigInt
  paidAt           DateTime
  executedByUserId String
  voucherFileId    String
  createdAt        DateTime @default(now())
}

model PaymentExecutionAllocation {
  id                       String    @id @default(uuid())
  paymentExecutionId       String
  paymentRequestId         String
  projectId                String
  contractId               String
  contractVersionId        String?
  settlementId             String?
  sourceType               String
  allocationType           String
  sourceRowId              String
  paymentTermsVersionId    String
  stageType                String
  stageId                  String?
  stageName                String?
  triggerAnchor            String?
  dueDays                  Int?
  ratioBps                 Int?
  fixedAmountCents         BigInt?
  sourceEffectiveAt        DateTime?
  expectedPayableAt        DateTime?
  sourcePayableAmountCents BigInt
  amountCents              BigInt
  allocationOrder          Int
  createdByUserId          String
  createdAt                DateTime  @default(now())

  @@unique([paymentExecutionId, allocationType, allocationOrder], map: "PaymentExecutionAllocation_execution_type_order_key")
  @@unique([paymentExecutionId, allocationType, sourceRowId], map: "PaymentExecutionAllocation_execution_type_row_key")
  @@index([paymentRequestId])
  @@index([contractId])
  @@index([settlementId])
  @@index([contractId, settlementId, stageId], map: "PaymentExecutionAllocation_contract_settlement_stage_idx")
}

model FinanceRecord {
  id                      String   @id @default(uuid())
  projectId               String
  paymentRequestId        String?
  projectExpenseRequestId String?
  settlementId            String?
  direction               String
  amountCents             BigInt
  occurredAt              DateTime
  createdByUserId         String
  createdAt               DateTime @default(now())

  @@index([projectExpenseRequestId])
}

model ProjectExpenseRequest {
  id                       String    @id @default(uuid())
  projectId                String
  code                     String    @unique
  expenseType              String
  expenseSubtype           String
  paymentSubject           String
  reason                   String
  requestedAmountCents     BigInt
  approvedAmountCents      BigInt?
  paidAmountCents          BigInt    @default(0)
  paymentMethod            String
  counterpartyName         String?
  counterpartyAccountName  String?
  counterpartyBankName     String?
  counterpartyBankAccount  String?
  handlerUserId            String
  applicantUserId          String
  attachmentFileId         String?
  purchaseExecutedByUserId String?
  purchaseExecutedAt       DateTime?
  purchaseExecutionNote    String?
  receiptConfirmedByUserId String?
  receiptConfirmedAt       DateTime?
  receiptConfirmationNote  String?
  status                   String
  voidedAt                 DateTime?
  voidedByUserId           String?
  voidReason               String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([projectId, status])
  @@index([attachmentFileId])
}

model ProjectExpenseExecution {
  id                      String   @id @default(uuid())
  projectExpenseRequestId String
  projectId               String
  amountCents             BigInt
  paidAt                  DateTime
  executedByUserId        String
  voucherFileId           String
  createdAt               DateTime @default(now())

  @@index([projectExpenseRequestId])
  @@index([projectId])
  @@index([voucherFileId])
}

model ProjectExpenseFinancingQuotaUsage {
  id                      String   @id @default(uuid())
  quotaId                 String
  projectExpenseRequestId String
  projectId               String
  amountCents             BigInt
  status                  String   @default("occupied")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([quotaId, projectExpenseRequestId])
  @@index([projectExpenseRequestId])
  @@index([projectId])
}

model ProjectReceipt {
  id               String    @id @default(uuid())
  projectId        String
  receivedAt       DateTime
  amountCents      BigInt
  payerName        String
  sourceType       String
  description      String?
  voucherFileId    String
  recordedByUserId String
  voidedAt         DateTime?
  voidedByUserId   String?
  voidReason       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([projectId, receivedAt])
  @@index([voucherFileId])
}

model ProjectProxyPayment {
  id                    String    @id @default(uuid())
  projectId             String
  paidAt                DateTime
  amountCents           BigInt
  generalContractorName String
  paidTargetName        String
  paymentType           String
  description           String?
  voucherFileId         String
  recordedByUserId      String
  contractId            String?
  settlementId          String?
  voidedAt              DateTime?
  voidedByUserId        String?
  voidReason            String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([projectId, paidAt])
  @@index([contractId])
  @@index([settlementId])
  @@index([voucherFileId])
}

model ProjectUpstreamSettlement {
  id                  String    @id @default(uuid())
  projectId           String
  settledAt           DateTime
  reportedAmountCents BigInt
  approvedAmountCents BigInt
  approvingPartyName  String
  periodLabel         String
  isFinal             Boolean   @default(false)
  description         String?
  voucherFileId       String
  recordedByUserId    String
  voidedAt            DateTime?
  voidedByUserId      String?
  voidReason          String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([projectId, settledAt])
  @@index([voucherFileId])
}

model ProjectOwnerContract {
  id                  String    @id @default(uuid())
  projectId           String
  ownerName           String
  contractName        String
  contractCode        String
  signedAt            DateTime
  amountCents         BigInt
  taxRateBps          Int
  pricingMethod       String
  paymentTermsSummary String
  retentionSummary    String
  fileId              String
  recordedByUserId    String
  confirmedByUserId   String?
  confirmedAt         DateTime?
  status              String    @default("pending_confirm")
  voidedAt            DateTime?
  voidedByUserId      String?
  voidReason          String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([projectId, signedAt])
  @@index([fileId])
}

model ProjectSettlementExceptionQuota {
  id                String    @id @default(uuid())
  projectId         String
  contractId        String
  amountCents       BigInt
  reason            String
  validUntil        DateTime
  attachmentFileId  String
  requestedByUserId String
  approvedByUserId  String?
  approvedAt        DateTime?
  status            String    @default("approval_pending")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([projectId, contractId, validUntil])
  @@index([attachmentFileId])
}

model ProjectSettlementExceptionQuotaUsage {
  id           String   @id @default(uuid())
  quotaId      String
  settlementId String
  projectId    String
  contractId   String
  amountCents  BigInt
  status       String   @default("occupied")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([quotaId, settlementId])
  @@index([settlementId])
  @@index([projectId, contractId])
}

model ProjectFinancingQuota {
  id                String    @id @default(uuid())
  projectId         String
  amountCents       BigInt
  reason            String
  validUntil        DateTime
  attachmentFileId  String
  requestedByUserId String
  approvedByUserId  String?
  approvedAt        DateTime?
  status            String    @default("approval_pending")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([projectId, validUntil])
  @@index([attachmentFileId])
}

model ProjectFinancingQuotaUsage {
  id               String   @id @default(uuid())
  quotaId          String
  paymentRequestId String
  projectId        String
  amountCents      BigInt
  status           String   @default("occupied")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([quotaId, paymentRequestId])
  @@index([paymentRequestId])
  @@index([projectId])
}

model ApprovalFlow {
  id        String   @id @default(uuid())
  type      String
  name      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApprovalFlowNode {
  id             String   @id @default(uuid())
  flowId         String
  sortOrder      Int
  name           String
  mode           String
  roleKeys       String[]
  minAmountCents BigInt?
  maxAmountCents BigInt?
}

model ApprovalInstance {
  id               String   @id @default(uuid())
  flowType         String
  businessType     String
  businessId       String
  status           String
  currentNodeIndex Int
  frozenNodes      Json
  applicantUserId  String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ApprovalActionLog {
  id                 String   @id @default(uuid())
  approvalInstanceId String
  action             String
  actorUserId        String
  comment            String?
  metadata           Json?
  createdAt          DateTime @default(now())
}

model ApprovalDelegation {
  id         String   @id @default(uuid())
  fromUserId String
  toUserId   String
  startsAt   DateTime
  endsAt     DateTime
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model FileObject {
  id                      String       @id @default(uuid())
  bucket                  String
  objectKey               String
  originalName            String
  mimeType                String
  sizeBytes               Int
  uploadedByUserId        String
  contentSha256           String?
  storageStatus           String       @default("active")
  supersedesFileObjectId  String?
  supersedesFileObject    FileObject?  @relation("FileObjectReplacement", fields: [supersedesFileObjectId], references: [id], onDelete: SetNull)
  supersededByFileObjects FileObject[] @relation("FileObjectReplacement")
  createdAt               DateTime     @default(now())

  @@index([supersedesFileObjectId])
  @@index([storageStatus])
}

model ArchiveRecord {
  id              String   @id @default(uuid())
  businessType    String
  businessId      String
  fileId          String
  departmentScope String
  createdAt       DateTime @default(now())
}

model PdfDocument {
  id           String   @id @default(uuid())
  businessType String
  businessId   String
  fileId       String
  templateKey  String
  createdAt    DateTime @default(now())
}

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?
  action       String
  businessType String?
  businessId   String?
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime @default(now())
}

model ContractBusinessTemplate {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  contractTypeKey String
  status          String   @default("draft")
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ContractBusinessTemplateVersion {
  id                     String    @id @default(uuid())
  templateId             String
  versionNo              Int
  status                 String    @default("draft")
  fieldSchema            Json
  billSchema             Json
  clauseSchema           Json
  attachmentSchema       Json
  validationSchema       Json
  supplementChangePolicy Json?
  submittedByUserId      String?
  publishedByUserId      String?
  publishedAt            DateTime?
  stoppedAt              DateTime?
  revokedAt              DateTime?
  changeSummary          String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([templateId, versionNo])
}

model ContractBusinessScenario {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  description     String?
  active          Boolean  @default(true)
  revision        Int      @default(1)
  createdByUserId String
  updatedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ContractScenarioTemplateMapping {
  id                        String   @id @default(uuid())
  businessScenarioId        String
  contractTypeKey           String
  businessTemplateVersionId String
  reason                    String
  priority                  Int      @default(0)
  active                    Boolean  @default(true)
  revision                  Int      @default(1)
  createdByUserId           String
  updatedByUserId           String
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@unique([businessScenarioId, businessTemplateVersionId])
  @@index([businessScenarioId, contractTypeKey, active])
}

model StandardClause {
  id              String   @id @default(uuid())
  code            String   @unique
  category        String
  name            String
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model StandardClauseVersion {
  id                String    @id @default(uuid())
  clauseId          String
  versionNo         Int
  status            String    @default("draft")
  title             String
  content           Json
  submittedByUserId String?
  publishedByUserId String?
  publishedAt       DateTime?
  changeSummary     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([clauseId, versionNo])
}

model BusinessParty {
  id                      String   @id @default(uuid())
  name                    String
  unifiedSocialCreditCode String?  @unique
  status                  String   @default("active")
  createdByUserId         String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model BusinessPartyVersion {
  id              String   @id @default(uuid())
  businessPartyId String
  versionNo       Int
  snapshot        Json
  createdByUserId String
  createdAt       DateTime @default(now())

  @@unique([businessPartyId, versionNo])
}

model ContractPartySnapshot {
  id                     String   @id @default(uuid())
  contractVersionId      String
  roleKey                String
  displayOrder           Int
  businessPartyVersionId String?
  snapshot               Json
  createdAt              DateTime @default(now())

  @@unique([contractVersionId, roleKey, displayOrder])
}

model ContractLayoutTemplate {
  id              String   @id @default(uuid())
  name            String
  contractTypeKey String
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ContractLayoutTemplateVersion {
  id                 String    @id @default(uuid())
  layoutTemplateId   String
  versionNo          Int
  status             String    @default("draft")
  docxFileId         String
  placeholderSchema  Json
  draftRevision      Int       @default(1)
  previewPdfFileId   String?
  inspectionReport   Json?
  inspectionRevision Int?
  submittedByUserId  String?
  publishedByUserId  String?
  publishedAt        DateTime?
  stoppedAt          DateTime?
  revokedAt          DateTime?
  changeSummary      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([layoutTemplateId, versionNo])
}

model ContractLayoutPreviewJob {
  id                      String    @id @default(uuid())
  layoutTemplateVersionId String
  status                  String    @default("queued")
  sampleData              Json
  sourceRevision          Int       @default(1)
  previewPdfFileId        String?
  errorMessage            String?
  startedAt               DateTime?
  completedAt             DateTime?
  createdByUserId         String
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model ContractDraftCheckpoint {
  id                String   @id @default(uuid())
  contractVersionId String
  sequenceNo        Int
  name              String?
  snapshot          Json
  createdByUserId   String
  createdAt         DateTime @default(now())

  @@unique([contractVersionId, sequenceNo])
}

model ContractNumberRule {
  id              String   @id @default(uuid())
  name            String
  pattern         String
  companyEntityId String?
  projectId       String?
  contractTypeKey String?
  nextSequence    Int      @default(1)
  sequenceWidth   Int      @default(3)
  isActive        Boolean  @default(true)
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ContractBill {
  id                      String   @id @default(uuid())
  contractVersionId       String
  billKey                 String
  name                    String
  amountRole              String
  pricingMode             String
  quantityScale           Int
  unitPriceScale          Int
  schemaSnapshot          Json
  sourceExcelFileId       String?
  revision                Int      @default(1)
  taxInclusiveAmountCents BigInt   @default(0)
  taxExclusiveAmountCents BigInt   @default(0)
  taxAmountCents          BigInt   @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([contractVersionId, billKey])
}

model ContractBillRow {
  id                      String   @id @default(uuid())
  contractBillId          String
  rowKey                  String
  sortOrder               Int
  itemCode                String?
  itemName                String
  specification           String?
  unit                    String
  quantity                Decimal  @db.Decimal(24, 6)
  unitPrice               Decimal  @db.Decimal(24, 6)
  taxRate                 Decimal  @db.Decimal(9, 6)
  taxInclusiveAmountCents BigInt
  taxExclusiveAmountCents BigInt
  taxAmountCents          BigInt
  isProvisional           Boolean  @default(false)
  settlementBasis         String?
  customData              Json
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([contractBillId, rowKey])
  @@index([contractBillId, sortOrder])
}

model ContractBillImport {
  id              String    @id @default(uuid())
  contractBillId  String
  fileId          String
  mode            String
  status          String
  preview         Json
  appliedByUserId String?
  appliedAt       DateTime?
  createdByUserId String
  createdAt       DateTime  @default(now())
}

model ContractGeneratedDocument {
  id                      String    @id @default(uuid())
  contractVersionId       String
  layoutTemplateVersionId String
  purpose                 String
  status                  String    @default("queued")
  sourceRevision          Int
  inputSnapshot           Json
  idempotencyKey          String    @unique
  docxFileId              String?
  pdfFileId               String?
  errorMessage            String?
  engineVersion           String
  createdByUserId         String
  startedAt               DateTime?
  completedAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model ContractOfflineRevision {
  id                        String    @id @default(uuid())
  contractVersionId         String
  negotiationRoundId        String?
  sourceGeneratedDocumentId String?
  sourceRevision            Int?
  fileId                    String
  previewPdfFileId          String?
  status                    String    @default("queued")
  errorMessage              String?
  label                     String
  note                      String?
  confirmedByUserId         String
  confirmedAt               DateTime  @default(now())
  startedAt                 DateTime?
  completedAt               DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([contractVersionId, createdAt])
  @@index([negotiationRoundId, createdAt])
  @@index([fileId])
}

model ContractNegotiationRound {
  id                        String    @id @default(uuid())
  contractVersionId         String
  roundNo                   Int
  status                    String    @default("open")
  sourceGeneratedDocumentId String
  sourceRevision            Int
  note                      String?
  openedByUserId            String
  openedAt                  DateTime  @default(now())
  closedByUserId            String?
  closedAt                  DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@unique([contractVersionId, roundNo])
  @@index([contractVersionId, status])
}

model ContractDocumentComparison {
  id                      String    @id @default(uuid())
  negotiationRoundId      String
  offlineRevisionId       String    @unique
  sourceRevision          Int
  status                  String    @default("queued")
  algorithmVersion        String?
  baseNormalizedSha256    String?
  revisedNormalizedSha256 String?
  errorMessage            String?
  startedAt               DateTime?
  completedAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([negotiationRoundId, status])
}

model ContractDocumentDifference {
  id                String    @id @default(uuid())
  comparisonId      String
  differenceKey     String
  sortOrder         Int
  changeType        String
  kind              String
  locationPath      String
  basePath          String?
  revisedPath       String?
  beforeText        String?
  afterText         String?
  candidate         Json?
  disposition       String    @default("pending")
  dispositionReason String?
  disposedByUserId  String?
  disposedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([comparisonId, differenceKey])
  @@index([comparisonId, sortOrder])
  @@index([comparisonId, disposition])
}
