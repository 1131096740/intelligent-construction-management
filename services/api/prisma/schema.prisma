  fundExecutionId                String
  revision                       Int
  status                         String
  predecessorCaseId              String?   @unique
  returnedFromCaseId             String?   @unique
  approvalInstanceId             String?
  reason                         String
  approvalInstanceSnapshot       Json?
  approvalInstanceFingerprint    String?
  approvalActionLogSnapshot      Json?
  approvalActionLogCount         Int?
  approvalActionLogFingerprint   String?
  finalApprovalActionLogId       String?
  finalApprovalActionFingerprint String?
  payloadFingerprint             String
  idempotencyKey                 String    @unique
  createdByUserId                String
  commandActorUserId             String
  submittedByUserId              String?
  submittedAt                    DateTime?
  returnedByUserId               String?
  returnedAt                     DateTime?
  returnReason                   String?
  confirmedByUserId              String?
  confirmedAt                    DateTime?
  auditAction                    String
  auditRequestId                 String
  createdTransactionId           BigInt
  createdBackendPid              Int
  createdAt                      DateTime  @default(now())

  @@unique([fundExecutionId, revision], map: "FundExecutionCase_execution_revision_key")
  @@unique([caseKey, revision], map: "FundExecutionCase_key_revision_key")
  @@index([fundExecutionId, status, createdAt])
  @@index([approvalInstanceId])
}

