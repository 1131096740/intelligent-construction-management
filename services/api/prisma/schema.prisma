generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid())
  phone              String?   @unique
  name               String
  departmentId       String?
  wxOpenid           String?   @unique
  passwordHash       String?
  mustChangePassword Boolean   @default(true)
  lastLoginAt        DateTime?
  isActive           Boolean   @default(true)
  // 旧上传签名只用于历史单据预览与回退；新审批从不可变 Canvas 版本取快照。
  signatureFileId    String?
  handwrittenSignatureVersions HandwrittenSignatureVersion[]
  handwrittenSignatureHandoffs HandwrittenSignatureHandoff[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([departmentId])
}

// Canvas 手写签名的不可变版本。新审批动作只允许绑定此表中的版本，旧上传图不回填。
model HandwrittenSignatureVersion {
  id            String   @id @default(uuid())
  userId        String
  fileId        String   @unique
  contentSha256 String
  source        String   @default("canvas")
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}

// 电脑端仅持有一次性链接；手机必须以同一账号完成签名，令牌本身不包含签名内容。
model HandwrittenSignatureHandoff {
  id                 String   @id @default(uuid())
  ownerUserId        String
  tokenHash          String   @unique
  expiresAt          DateTime
  invalidatedAt      DateTime?
  completedAt        DateTime?
  signatureVersionId String?
  createdAt          DateTime @default(now())

  ownerUser User @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([ownerUserId, expiresAt])
}

// 我方公司主体字典：合同签订时选择其一，名称快照进合同。
model CompanyEntity {
  id                      String   @id @default(uuid())
  name                    String
  unifiedSocialCreditCode String?
  registeredAddress       String?
  dataStatus              String   @default("legacy_incomplete")
  currentVersionNo        Int      @default(0)
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model CompanyEntityVersion {
  id                      String   @id @default(uuid())
  companyEntityId         String
  versionNo               Int
  name                    String
  unifiedSocialCreditCode String?
  registeredAddress       String?
  isActive                Boolean
  action                  String
  actorUserId             String?
  actorRoleKey            String?
  createdAt               DateTime @default(now())

  @@unique([companyEntityId, versionNo])
  @@index([name])
  @@index([unifiedSocialCreditCode])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

// 所有新业务正式编号按前缀和北京时间自然日独立递增；编号允许断号且不回收。
model BusinessDailySequence {
  prefix       String
  businessDate String
  nextSequence Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([prefix, businessDate])
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  parentId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model Position {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserPosition {
  id         String   @id @default(uuid())
  userId     String
  positionId String
  projectId  String?
  createdAt  DateTime @default(now())

  @@unique([userId, positionId, projectId])
}

model Project {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 项目挂靠企业只通过显式映射生效；变更时结束旧行并新增快照，不覆盖历史事实。
model ProjectAffiliateAssignment {
  id                          String    @id @default(uuid())
  projectId                   String
  businessPartyId             String
  businessPartyVersionId      String
  affiliateNameSnapshot       String
  affiliateCreditCodeSnapshot String?
  effectiveFrom               DateTime
  endedAt                     DateTime?
  changeReason                String
  assignedByUserId            String
  endedByUserId               String?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([projectId, effectiveFrom])
  @@index([businessPartyId])
  @@index([businessPartyVersionId])
}

model ProjectMember {
  id          String   @id @default(uuid())
  projectId   String
  userId      String
  positionKey String
  createdAt   DateTime @default(now())

  @@unique([projectId, userId, positionKey])
}

// 项目花名册归属仅控制人员归属与项目可见性，不授予任何项目业务岗位。
model ProjectRosterMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model Contract {
  id                        String    @id @default(uuid())
  projectId                 String
  source                    String    @default("system")
  code                      String?   @unique
  name                      String
  counterparty              String
  companyEntityId           String?
  companyEntityName         String?
  contractTypeKey           String?
  ownerUserId               String?
  businessScenarioId        String?
  scenarioTemplateMappingId String?
  scenarioSnapshot          Json?
  temporaryCode             String?   @unique
  settlementClosedAt        DateTime?
  finalSettlementId         String?   @unique
  voidedAt                  DateTime?
  voidedReason              String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([businessScenarioId])
  @@index([scenarioTemplateMappingId])
}

model ContractVersion {
  id                                     String    @id @default(uuid())
  contractId                             String
  versionNo                              Int
  changeType                             String
  status                                 String
  amountCents                            BigInt
  estimatedAmountCents                   BigInt?
  baseVersionId                          String?
  supersedesVersionId                    String?
  copiedFromContractVersionId            String?
  changeReason                           String?
  changeDirection                        String?
  changeAmountCents                      BigInt?
  originalBaseAmountCents                BigInt?
  cumulativeIncreaseCents                BigInt    @default(0)
  cumulativeDecreaseCents                BigInt    @default(0)
  amountLimitType                        String    @default("capped")
  settlementMode                         String?
  settlementModeSource                   String?
  settlementModeConfirmedByUserId        String?
  settlementModeConfirmedAt              DateTime?
  effectiveAt                            DateTime?
  businessTemplateVersionId              String?
  layoutTemplateVersionId                String?
  draftRevision                          Int       @default(1)
  firstSubmittedAt                       DateTime?
  latestDraftPreviewDocumentId           String?
  pricingNature                          String    @default("fixed_total")
  amountSource                           String    @default("manual")
  amountAdjustmentReason                 String?
  invoiceType                            String?
  taxMode                                String    @default("single_rate")
  defaultTaxRatePercent                  Decimal?  @db.Decimal(9, 6)
  taxFactStatus                          String    @default("unconfirmed")
  taxFactSource                          String?
  taxFactExplanation                     String?
  taxFactEvidenceFileId                  String?
  taxFactRevision                        Int       @default(0)
  taxFactsFrozenAt                       DateTime?
  contractGovernanceVersion              Int?
  companyEntityIdSnapshot                String?
  companyEntityVersionId                 String?
  companyEntityNameSnapshot              String?
  companyEntityCreditCodeSnapshot        String?
  companyEntityRegisteredAddressSnapshot String?
  signingSubjectType                     String    @default("our_company")
  affiliateAssignmentId                  String?
  affiliateBusinessPartyVersionId        String?
  affiliateNameSnapshot                  String?
  affiliateCreditCodeSnapshot            String?
  draftData                              Json
  templateSnapshot                       Json
  clauseSnapshot                         Json
  readinessSnapshot                      Json?
  abandonedAt                            DateTime?
  abandonedByUserId                      String?
  abandonReason                          String?
  createdAt                              DateTime  @default(now())
  updatedAt                              DateTime  @updatedAt

  @@unique([contractId, versionNo])
  @@index([baseVersionId])
  @@index([supersedesVersionId])
  @@index([copiedFromContractVersionId])
  @@index([companyEntityIdSnapshot])
  @@index([companyEntityVersionId])
  @@index([status, updatedAt])
}

model ContractDraftEditLease {
  contractVersionId String   @id
  holderUserId      String
  tokenHash         String   @unique
  leaseRevision     Int      @default(1)
  acquiredAt        DateTime @default(now())
  heartbeatAt       DateTime @default(now())
  expiresAt         DateTime
  updatedAt         DateTime @updatedAt

  @@index([holderUserId])
  @@index([expiresAt])
}

model ContractDraftAttachment {
  id                String   @id @default(uuid())
  contractVersionId String
  slotKey           String
  fileId             String
  displayOrder       Int
  createdByUserId    String
  createdAt          DateTime @default(now())

  @@unique([contractVersionId, slotKey, displayOrder])
  @@unique([contractVersionId, slotKey, fileId])
  @@index([fileId])
  @@index([createdByUserId])
}

model ContractDraftSaveRequest {
  idempotencyKey    String   @id
  contractVersionId String
  expectedRevision  Int
  resultRevision    Int
  saveKind          String
  requestSha256     String
  responseSnapshot  Json
  createdByUserId   String
  createdAt         DateTime @default(now())
  expiresAt         DateTime

  @@index([contractVersionId, createdAt])
  @@index([createdByUserId])
  @@index([expiresAt])
}

model ContractDraftSubmissionRequest {
  idempotencyKey     String   @id
  contractVersionId  String
  expectedRevision   Int
  applicantUserId    String
  requestSha256      String
  approvalInstanceId String   @unique
  formalCode         String
  responseSnapshot   Json
  createdAt          DateTime @default(now())

  @@index([contractVersionId, createdAt])
  @@index([applicantUserId])
}

model ContractTaxFactRevision {
  id                      String    @id @default(uuid())
  projectId               String
  contractId              String
  contractVersionId       String
  revisionNo              Int
  kind                    String
  status                  String    @default("draft")
  invoiceType             String?
  taxMode                 String?
  defaultTaxRatePercent   Decimal?  @db.Decimal(9, 6)
  source                  String?
  confirmationExplanation String?
  evidenceFileId          String?
  rowFacts                Json
  beforeSnapshot          Json
  createdByUserId         String
  submittedByUserId       String?
  submittedAt             DateTime?
  financeReviewedByUserId String?
  financeReviewedAt       DateTime?
  financeReviewComment    String?
  confirmedByUserId       String?
  confirmedAt             DateTime?
  contractReviewComment   String?
  abandonedAt             DateTime?
  abandonedByUserId       String?
  abandonReason           String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([contractVersionId, revisionNo])
  @@index([projectId, status])
  @@index([contractVersionId, status])
  @@index([status, updatedAt])
}

model ContractTakeover {
  id                                    String                 @id @default(uuid())
  projectId                             String
  takeoverBatchId                       String?
  importRowNo                           Int?
  contractId                            String
  contractVersionId                     String                 @unique
  paymentTermsVersionId                 String
  takeoverLevel                         String
  suggestedTakeoverLevel                String?
  takeoverLevelAdjustmentReason         String?
  takeoverStatus                        String
  lifecycleStatus                       String
  signedAt                              DateTime
  historicalSettledCents                BigInt                 @default(0)
  historicalApprovalPendingPaymentCents BigInt                 @default(0)
  historicalApprovedPendingPaymentCents BigInt                 @default(0)
  historicalPaidCents                   BigInt                 @default(0)
  historicalProxyPaidCents              BigInt                 @default(0)
  historicalAdvancePaidCents            BigInt                 @default(0)
  historicalAdvanceDeductedCents        BigInt                 @default(0)
  historicalRetentionWithheldCents      BigInt                 @default(0)
  historicalRetentionReleasedCents      BigInt                 @default(0)
  otherConfirmedOccupancyCents          BigInt                 @default(0)
  balanceSourceSummary                  String?
  evidenceSummary                       String?
  takeoverCutoffDate                    DateTime?
  responsibleUserId                     String?
  reviewComment                         String?
  acceptanceConclusion                  String?
  createdByUserId                       String
  submittedByUserId                     String?
  submittedAt                           DateTime?
  confirmedByUserId                     String?
  confirmedAt                           DateTime?
  historicalBalanceConfirmedByUserId    String?
  historicalBalanceConfirmedAt          DateTime?
  activationIdempotencyKey              String?                @unique
  activatedAt                           DateTime?
  activatedByUserId                     String?
  historicalInitialSettlementId         String?                @unique
  abandonedAt                           DateTime?
  abandonedByUserId                     String?
  abandonReason                         String?
  createdAt                             DateTime               @default(now())
  updatedAt                             DateTime               @updatedAt
  takeoverBatch                         ContractTakeoverBatch? @relation(fields: [takeoverBatchId], references: [id])

  @@unique([takeoverBatchId, importRowNo])
  @@index([projectId, takeoverStatus])
  @@index([takeoverBatchId])
  @@index([contractId])
  @@index([contractVersionId])
  @@index([takeoverStatus, updatedAt])
}

model ContractTakeoverBatch {
  id                   String             @id @default(uuid())
  projectId            String
  batchNo              String
  status               String
  takeoverCutoffDate   DateTime
  responsibleUserId    String
  reviewComment        String
  acceptanceConclusion String
  importFingerprint    String
  totalRows            Int                @default(0)
  readyRows            Int                @default(0)
  blockedRows          Int                @default(0)
  warningRows          Int                @default(0)
  createdCount         Int                @default(0)
  skippedCount         Int                @default(0)
  createdByUserId      String
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  takeovers            ContractTakeover[]

  @@unique([projectId, batchNo])
  @@unique([projectId, importFingerprint])
  @@index([projectId, status])
}

model ContractTakeoverCorrection {
  id                    String    @id @default(uuid())
  projectId             String
  takeoverId            String
  schemaVersion         Int       @default(1)
  correctionType        String
  correctionScope       String?
  correctionOperation   String?
  status                String    @default("confirmed")
  targetRevision        Int?
  targetBalanceRevision Int?
  deltaSnapshot         Json?
  targetHistoricalPaymentId String?
  targetAllocationId    String?
  targetBalanceEntryId  String?
  applicationIdempotencyKey String? @unique
  targetCompanyEntityId String?
  beforeSnapshot        Json
  afterSnapshot         Json
  reason                String
  responsibleUserId     String
  attachmentFileId      String
  createdByUserId       String
  submittedByUserId     String?
  submittedAt           DateTime?
  reviewedByUserId      String?
  reviewedAt            DateTime?
  reviewComment         String?
  appliedByUserId       String?
  appliedAt             DateTime?
  createdAt             DateTime  @default(now())

  @@index([projectId, takeoverId, createdAt])
  @@index([takeoverId])
  @@index([takeoverId, correctionType, status])
  @@index([takeoverId, schemaVersion, status])
  @@index([targetHistoricalPaymentId])
  @@index([targetAllocationId])
  @@index([targetBalanceEntryId])
}

model ContractTakeoverContractFacts {
  takeoverId                String    @id
  revision                  Int       @default(1)
  financeBasisRevision      Int       @default(1)
  signedAt                  DateTime
  historicalSettledCents    BigInt    @default(0)
  zeroSettlementDeclared    Boolean   @default(false)
  performanceStatus         String
  settlementEvidenceSummary String?
  paymentTermsSnapshot      Json
  contractFactsSnapshot     Json
  confirmedRevision         Int?
  confirmedByUserId         String?
  confirmedAt               DateTime?
  updatedByUserId           String
  updatedAt                 DateTime  @updatedAt
}

model ContractTakeoverFinanceFacts {
  takeoverId                    String    @id
  revision                      Int       @default(1)
  basedOnContractRevision       Int
  basedOnFinanceBasisRevision   Int
  zeroPaymentDeclared           Boolean   @default(false)
  excessTreatment               String?
  excessReason                  String?
  confirmedRevision             Int?
  confirmedContractRevision     Int?
  confirmedFinanceBasisRevision Int?
  confirmedByUserId             String?
  confirmedAt                   DateTime?
  updatedByUserId               String
  updatedAt                     DateTime  @updatedAt
}

model ContractTakeoverHistoricalPayment {
  id            String    @id @default(uuid())
  takeoverId    String
  rowKey        String
  sequenceNo    Int
  amountCents   BigInt
  paidAt        DateTime
  payerName     String?
  payeeName     String?
  bankReference String?
  paymentMethod String?
  note          String?
  status        String    @default("draft")
  activatedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([takeoverId, rowKey])
  @@unique([takeoverId, sequenceNo])
  @@index([takeoverId, status])
}

model ContractTakeoverHistoricalPaymentAllocation {
  id                  String   @id @default(uuid())
  historicalPaymentId String
  allocationType      String
  amountCents         BigInt
  allocationOrder     Int
  createdAt           DateTime @default(now())

  @@unique([historicalPaymentId, allocationOrder])
  @@index([historicalPaymentId])
}

model ContractTakeoverHistoricalPaymentVoucher {
  id                  String   @id @default(uuid())
  historicalPaymentId String
  fileId              String   @unique
  displayOrder        Int
  uploadedByUserId    String
  createdAt           DateTime @default(now())

  @@unique([historicalPaymentId, displayOrder])
  @@index([historicalPaymentId])
  @@index([uploadedByUserId])
}

model ContractTakeoverSettlementEvidence {
  id              String   @id @default(uuid())
  takeoverId      String
  fileId          String   @unique
  displayOrder    Int
  createdByUserId String
  createdAt       DateTime @default(now())

  @@unique([takeoverId, displayOrder])
  @@index([takeoverId])
  @@index([createdByUserId])
}

model ContractTakeoverExcessEvidence {
  id              String   @id @default(uuid())
  takeoverId      String
  fileId          String   @unique
  displayOrder    Int
  createdByUserId String
  createdAt       DateTime @default(now())

  @@unique([takeoverId, displayOrder])
  @@index([takeoverId])
  @@index([createdByUserId])
}

model ContractTakeoverSideSaveRequest {
  idempotencyKey   String   @id
  takeoverId       String
  side             String
  expectedRevision Int
  resultRevision   Int
  requestSha256    String
  responseSnapshot Json
  createdByUserId  String
  createdAt        DateTime @default(now())
  expiresAt        DateTime

  @@index([takeoverId, side, createdAt])
  @@index([createdByUserId])
  @@index([expiresAt])
}

model ContractTakeoverBalanceAccount {
  id           String   @id @default(uuid())
  takeoverId   String
  balanceType  String
  openingCents BigInt
  balanceCents BigInt
  revision     Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([takeoverId, balanceType])
  @@index([takeoverId])
}

model ContractTakeoverBalanceEntry {
  id                  String   @id @default(uuid())
  accountId           String
  entryKind           String
  amountCents         BigInt
  settlementId        String?
  historicalPaymentId String?
  correctionId        String?
  reversesEntryId     String?  @unique
  idempotencyKey      String   @unique
  createdByUserId     String
  createdAt           DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([settlementId])
  @@index([historicalPaymentId])
  @@index([correctionId])
  @@index([createdByUserId])
}

model ContractTakeoverConfirmationEvent {
  id                           String   @id @default(uuid())
  idempotencyKey               String   @unique
  takeoverId                   String
  side                         String
  action                       String
  revision                     Int
  observedOtherSideRevision    Int?
  observedFinanceBasisRevision Int?
  reason                       String?
  actorUserId                  String
  responseSnapshot             Json?
  createdAt                    DateTime @default(now())

  @@index([takeoverId, side, createdAt])
  @@index([actorUserId])
}

model PaymentTermsVersion {
  id                String   @id @default(uuid())
  contractId        String
  contractVersionId String
  versionNo         Int
  status            String
  originalText      String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([contractId, versionNo])
}

model PaymentTermsStage {
  id                            String           @id @default(uuid())
  paymentTermsVersionId         String
  name                          String
  stageType                     String           @default("progress")
  basis                         String
  ratioBps                      Int?
  fixedAmountCents              BigInt?
  triggerAnchor                 String           @default("settlement_effective")
  triggerEvent                  String
  dueDays                       Int
  advanceDeductionMode          String           @default("none")
  advanceDeductionRatioBps      Int?
  advanceDeductionStartRatioBps Int?
  requiresInvoice               Boolean          @default(false)
  allowsEarlyPayment            Boolean          @default(false)
  allowsInstallments            Boolean          @default(true)
  retentionBps                  Int?
  originalText                  String
  createdAt                     DateTime         @default(now())
  paymentRequests               PaymentRequest[] @relation("PaymentRequestFrozenStage")

  @@unique([id, paymentTermsVersionId], map: "PaymentTermsStage_id_paymentTermsVersionId_key")
}

model ContractArchiveFile {
  id                String    @id @default(uuid())
  contractVersionId String
  fileId            String
  uploadedByUserId  String
  confirmedByUserId String?
  confirmedAt       DateTime?
  status            String
  createdAt         DateTime  @default(now())
}

model ContractFormalFile {
  id                   String    @id @default(uuid())
  contractVersionId    String
