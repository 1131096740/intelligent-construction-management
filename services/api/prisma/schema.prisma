generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                 String                            @id @default(uuid())
  phone                              String?                           @unique
  name                               String
  departmentId                       String?
  wxOpenid                           String?                           @unique
  passwordHash                       String?
  mustChangePassword                 Boolean                           @default(true)
  lastLoginAt                        DateTime?
  isActive                           Boolean                           @default(true)
  // 旧上传签名只用于历史单据预览与回退；新审批从不可变 Canvas 版本取快照。
  signatureFileId                    String?
  handwrittenSignatureVersions       HandwrittenSignatureVersion[]
  handwrittenSignatureHandoffs       HandwrittenSignatureHandoff[]
  businessEntrySubmissionSnapshots   BusinessEntrySubmissionSnapshot[]
  wageCreditorBreakdowns             WageCreditorBreakdown[]           @relation("WageCreditorUser")
  fundMovementsCreated               FundMovement[]                    @relation("FundMovementCreatedBy")
  fundMovementsSubmitted             FundMovement[]                    @relation("FundMovementSubmittedBy")
  fundMovementsConfirmed             FundMovement[]                    @relation("FundMovementConfirmedBy")
  fundMovementLegsCreated            FundMovementLeg[]                 @relation("FundMovementLegCreatedBy")
  fundMovementRelationshipsCreated   FundMovementRelationshipEntry[]   @relation("FundMovementRelationshipCreatedBy")
  fundMovementRelationshipsConfirmed FundMovementRelationshipEntry[]   @relation("FundMovementRelationshipConfirmedBy")
  createdAt                          DateTime                          @default(now())
  updatedAt                          DateTime                          @updatedAt

  @@index([departmentId])
}

// Canvas 手写签名的不可变版本。新审批动作只允许绑定此表中的版本，旧上传图不回填。
model HandwrittenSignatureVersion {
  id            String   @id @default(uuid())
  userId        String
  fileId        String   @unique
  contentSha256 String
  source        String   @default("canvas")
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}

// 电脑端仅持有一次性链接；手机必须以同一账号完成签名，令牌本身不包含签名内容。
model HandwrittenSignatureHandoff {
  id                 String    @id @default(uuid())
  ownerUserId        String
  tokenHash          String    @unique
  expiresAt          DateTime
  invalidatedAt      DateTime?
  completedAt        DateTime?
  signatureVersionId String?
  createdAt          DateTime  @default(now())

  ownerUser User @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([ownerUserId, expiresAt])
}

// 我方公司主体字典：合同签订时选择其一，名称快照进合同。
model CompanyEntity {
  id                                  String                          @id @default(uuid())
  name                                String
  unifiedSocialCreditCode             String?
  registeredAddress                   String?
  dataStatus                          String                          @default("legacy_incomplete")
  currentVersionNo                    Int                             @default(0)
  isActive                            Boolean                         @default(true)
  fundMovementsAsSource               FundMovement[]                  @relation("FundMovementSourceCompany")
  fundMovementsAsBeneficiary          FundMovement[]                  @relation("FundMovementBeneficiaryCompany")
  fundMovementLegs                    FundMovementLeg[]               @relation("FundMovementLegCompany")
  fundMovementRelationshipsAsDebtor   FundMovementRelationshipEntry[] @relation("FundMovementRelationshipDebtorCompany")
  fundMovementRelationshipsAsCreditor FundMovementRelationshipEntry[] @relation("FundMovementRelationshipCreditorCompany")
  createdAt                           DateTime                        @default(now())
  updatedAt                           DateTime                        @updatedAt
}

// Server-issued bank-account legal-holder authority.  This is intentionally
// not a user-maintained bank-account directory: payment execution accepts
// only the opaque reference issued by the verification authority and freezes
// the verified holder facts below.
model PaymentExecutionPayerVerification {
  id                                String   @id @default(uuid())
  reference                         String   @unique
  holderCompanyEntityId             String
  holderNameSnapshot                String
  holderCreditCodeSnapshot          String
  verificationReference             String
  verifiedByUserId                  String
  verifiedAt                        DateTime
  verificationEvidenceFileId        String
  verificationEvidenceContentSha256 String
  status                            String   @default("verified")
  sourceType                        String   @default("bank_account_legal_holder")
  sourceRecordId                    String
  issuedByDatabaseRole              String   @default("jg_payment_execution_payer_issuer")
  createdAt                         DateTime @default(now())

  @@unique([sourceType, sourceRecordId])
  @@index([holderCompanyEntityId, status])
  @@index([verificationEvidenceFileId])
  @@index([verifiedByUserId])
}

model CompanyEntityVersion {
  id                      String   @id @default(uuid())
  companyEntityId         String
  versionNo               Int
  name                    String
  unifiedSocialCreditCode String?
  registeredAddress       String?
  isActive                Boolean
  action                  String
  actorUserId             String?
  actorRoleKey            String?
  createdAt               DateTime @default(now())

  @@unique([companyEntityId, versionNo])
  @@index([name])
  @@index([unifiedSocialCreditCode])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

// 所有新业务正式编号按前缀和北京时间自然日独立递增；编号允许断号且不回收。
model BusinessDailySequence {
  prefix       String
  businessDate String
  nextSequence Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([prefix, businessDate])
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  parentId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model Position {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserPosition {
  id         String   @id @default(uuid())
  userId     String
  positionId String
  projectId  String?
  createdAt  DateTime @default(now())

  @@unique([userId, positionId, projectId])
}

model Project {
  id                                     String                            @id @default(uuid())
  code                                   String                            @unique
  name                                   String
  operatingLedgerEffectiveDate           DateTime?                         @db.Date
  takeoverCompletedDate                  DateTime?                         @db.Date
  takeoverStatus                         String                            @default("preparing")
  constructionEnterpriseLockedAt         DateTime?
  businessEntrySubmissionSnapshots       BusinessEntrySubmissionSnapshot[]
  fundMovementsAsSource                  FundMovement[]                    @relation("FundMovementSourceProject")
  fundMovementsAsBeneficiary             FundMovement[]                    @relation("FundMovementBeneficiaryProject")
  fundMovementLegs                       FundMovementLeg[]                 @relation("FundMovementLegProject")
  fundMovementRelationshipsAsSource      FundMovementRelationshipEntry[]   @relation("FundMovementRelationshipSourceProject")
  fundMovementRelationshipsAsBeneficiary FundMovementRelationshipEntry[]   @relation("FundMovementRelationshipBeneficiaryProject")
  isActive                               Boolean                           @default(true)
  createdAt                              DateTime                          @default(now())
  updatedAt                              DateTime                          @updatedAt
}

// 项目挂靠企业只通过显式映射生效；变更时结束旧行并新增快照，不覆盖历史事实。
model ProjectAffiliateAssignment {
  id                          String    @id @default(uuid())
  projectId                   String
  businessPartyId             String
  businessPartyVersionId      String
  affiliateNameSnapshot       String
  affiliateCreditCodeSnapshot String?
  effectiveFrom               DateTime
  endedAt                     DateTime?
  changeReason                String
  assignedByUserId            String
  endedByUserId               String?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([projectId, effectiveFrom])
  @@index([businessPartyId])
  @@index([businessPartyVersionId])
}

// 项目参与公司按生效期间追加；已有正式事实的历史行不得覆盖。
model ProjectParticipatingCompany {
  id                        String    @id @default(uuid())
  projectId                 String
  companyEntityId           String
  companyEntityVersionId    String
  companyNameSnapshot       String
  companyCreditCodeSnapshot String?
  effectiveFrom             DateTime  @db.Date
  endedAt                   DateTime? @db.Date
  changeReason              String
  addedByUserId             String
  endedByUserId             String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([projectId, effectiveFrom])
  @@index([companyEntityId])
  @@index([companyEntityVersionId])
}

// 正式经营事实信封只允许追加；更正和冲销通过新增事实引用原事实。
model OperatingFact {
  id                                   String   @id @default(uuid())
  projectId                            String
  sourceType                           String
  sourceBusinessId                     String
  sourceVersion                        Int
  sourceBusinessCode                   String
  occurredAt                           DateTime
  recordedAt                           DateTime @default(now())
  confirmedAt                          DateTime
  affiliateAssignmentId                String
  affiliateBusinessPartyVersionId      String
  affiliateNameSnapshot                String
  affiliateCreditCodeSnapshot          String?
  operatingLedgerEffectiveDateSnapshot DateTime @db.Date
  isBeforeOperatingLedgerEffectiveDate Boolean
  historicalTakeoverBatchId            String?
  factKind                             String
  operatingLevel                       String
  evidenceLevel                        String
  amountCents                          BigInt
  currencyCode                         String   @default("CNY")
  direction                            String
  debtorSubjectKind                    String?
  debtorSubjectId                      String?
  creditorSubjectKind                  String?
  creditorSubjectId                    String?
  approvedPayerSubjectKind             String?
  approvedPayerSubjectId               String?
  actualPayerSubjectKind               String?
  actualPayerSubjectId                 String?
  payeeSubjectKind                     String?
  payeeSubjectId                       String?
  costBearingCompanySubjectKind        String?
  costBearingCompanySubjectId          String?
  subjectSnapshot                      Json
  sourceSnapshot                       Json
  basisSnapshot                        Json?
  entryKind                            String   @default("original")
  adjustsFactId                        String?
  idempotencyKey                       String   @unique
  recordedByUserId                     String
  confirmedByUserId                    String
  status                               String   @default("confirmed")
  paymentExecutionId                   String?
  fundExecutionId                      String?
  fundExecutionCaseId                  String?
  createdAt                            DateTime @default(now())

  fundMovementLegs    FundMovementLeg[]      @relation("FundMovementLegOperatingFact")
  impacts             OperatingImpactEntry[] @relation("OperatingFactImpacts")
  clearingImpactLinks ClearingImpactLink[]   @relation("ClearingImpactFact")
  originalFact        OperatingFact?         @relation("OperatingFactAdjustments", fields: [adjustsFactId], references: [id], onDelete: Restrict)
  adjustments         OperatingFact[]        @relation("OperatingFactAdjustments")

  @@unique([sourceType, sourceBusinessId])
  @@unique([id, projectId], map: "OperatingFact_id_projectId_key")
  @@index([projectId, occurredAt])
  @@index([projectId, status, occurredAt])
  @@index([adjustsFactId])
  @@index([affiliateAssignmentId])
  @@index([historicalTakeoverBatchId])
}

model OperatingImpactEntry {
  id                        String                           @id @default(uuid())
  factId                    String
  projectId                 String
  sourceType                String
  sourceBusinessId          String
  sourceImpactKey           String
  idempotencyKey            String                           @unique
  impactKind                String
  amountCents               BigInt
  direction                 String
  subjectRole               String?
  subjectKind               String?
  subjectId                 String?
  costCategoryCode          String?
  fundPurpose               String?
  description               String?
  impactSnapshot            Json
  paymentExecutionId        String?
  fundExecutionId           String?
  fundExecutionCaseId       String?
  executionAllocationLineId String?
  createdAt                 DateTime                         @default(now())
  fact                      OperatingFact                    @relation("OperatingFactImpacts", fields: [factId, projectId], references: [id, projectId], onDelete: Restrict)
  clearingImpactLinks       ClearingImpactLink[]             @relation("ClearingImpactEntry")
  wageTakeoverImpactBridges WageTakeoverLegacyImpactBridge[]

  @@unique([factId, sourceImpactKey])
  @@unique([sourceType, sourceBusinessId, sourceImpactKey], map: "OperatingImpactEntry_source_impact_key")
  @@index([projectId, impactKind, createdAt])
  @@index([factId])
}

// POL-11A 清分核心：稳定 case/event 标识与不可变版本分离，正式影响仍投影到 OperatingFact。
model ClearingCase {
  id                                 String          @id @default(uuid())
  projectId                          String
  constructionEnterpriseAssignmentId String
  category                           String
  governedSubjectKey                 String
  status                             String          @default("open")
  revision                           Int             @default(1)
  authoritativeGrossCapCents         BigInt
  currencyCode                       String          @default("CNY")
  authorityVersionId                 String?
  authoritySnapshotRef               String?
  sourceDiscriminator                String?
  coverageKind                       String?
  periodStart                        DateTime?       @db.Date
  createdByUserId                    String
  createdAt                          DateTime        @default(now())
  updatedAt                          DateTime        @updatedAt
  events                             ClearingEvent[]

  @@unique([projectId, constructionEnterpriseAssignmentId, category, governedSubjectKey], map: "ClearingCase_natural_key")
  @@index([projectId, status, updatedAt])
  @@index([constructionEnterpriseAssignmentId])
}

model ClearingEvent {
  id               String                 @id @default(uuid())
  clearingCaseId   String
  kind             String
  workflowStatus   String                 @default("draft")
  revision         Int                    @default(1)
  currentVersionNo Int                    @default(1)
  createdByUserId  String
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  clearingCase     ClearingCase           @relation(fields: [clearingCaseId], references: [id], onDelete: Restrict)
  versions         ClearingEventVersion[]

  @@index([clearingCaseId, workflowStatus, createdAt])
  @@index([clearingCaseId, kind])
}

model ClearingEventVersion {
  id                String                       @id @default(uuid())
  clearingEventId   String
  clearingCaseId    String
  versionNo         Int
  workflowStatus    String
  amountCents       BigInt
  currencyCode      String                       @default("CNY")
  payableRef        String?
  evidenceLevel     String
  payloadSnapshot   Json
  actorSetSnapshot  Json
  fingerprint       String
  previousVersionId String?
  createdByUserId   String
  createdAt         DateTime                     @default(now())
  clearingEvent     ClearingEvent                @relation(fields: [clearingEventId], references: [id], onDelete: Restrict)
  confirmation      ClearingConfirmation?
  attestation       ClearingEvidenceAttestation?
  allocations       ClearingAllocation[]         @relation("ClearingAllocationTarget")
  sourceAllocations ClearingAllocation[]         @relation("ClearingAllocationSource")
  impactLinks       ClearingImpactLink[]
  previousVersion   ClearingEventVersion?        @relation("ClearingEventVersionHistory", fields: [previousVersionId], references: [id], onDelete: Restrict)
  nextVersions      ClearingEventVersion[]       @relation("ClearingEventVersionHistory")

  @@unique([clearingEventId, versionNo])
  @@index([clearingCaseId, createdAt])
  @@index([previousVersionId])
}

model ClearingEvidenceAttestation {
  id                       String               @id @default(uuid())
  eventVersionId           String               @unique
  attestedByUserId         String
  attesterActorSetSnapshot Json
  attestedAt               DateTime             @default(now())
  eventVersion             ClearingEventVersion @relation(fields: [eventVersionId], references: [id], onDelete: Restrict)
}

model ClearingConfirmation {
  id                        String               @id @default(uuid())
  eventVersionId            String               @unique
  confirmedByUserId         String
  confirmerActorSetSnapshot Json
  confirmedAt               DateTime             @default(now())
  eventVersion              ClearingEventVersion @relation(fields: [eventVersionId], references: [id], onDelete: Restrict)
}

model ClearingAllocation {
  id                        String                @id @default(uuid())
  eventVersionId            String
  sourceEventVersionId      String?
  sourceKind                String
  amountCents               BigInt
  sourceRemainingAfterCents BigInt
  reversesAllocationId      String?
  createdAt                 DateTime              @default(now())
  eventVersion              ClearingEventVersion  @relation("ClearingAllocationTarget", fields: [eventVersionId], references: [id], onDelete: Restrict)
  sourceEventVersion        ClearingEventVersion? @relation("ClearingAllocationSource", fields: [sourceEventVersionId], references: [id], onDelete: Restrict)
  reversesAllocation        ClearingAllocation?   @relation("ClearingAllocationReversal", fields: [reversesAllocationId], references: [id], onDelete: Restrict)
  reversedByAllocations     ClearingAllocation[]  @relation("ClearingAllocationReversal")

  @@index([eventVersionId])
  @@index([sourceEventVersionId])
  @@index([reversesAllocationId])
}

model ClearingImpactLink {
  id                String               @id @default(uuid())
  eventVersionId    String
  operatingFactId   String
  operatingImpactId String
  sourceImpactKey   String
  reversesImpactId  String?
  amountCents       BigInt
  createdAt         DateTime             @default(now())
  eventVersion      ClearingEventVersion @relation(fields: [eventVersionId], references: [id], onDelete: Restrict)
  operatingFact     OperatingFact        @relation("ClearingImpactFact", fields: [operatingFactId], references: [id], onDelete: Restrict)
  operatingImpact   OperatingImpactEntry @relation("ClearingImpactEntry", fields: [operatingImpactId], references: [id], onDelete: Restrict)
  reversesImpact    ClearingImpactLink?  @relation("ClearingImpactReversal", fields: [reversesImpactId], references: [id], onDelete: Restrict)
  reversedByImpacts ClearingImpactLink[] @relation("ClearingImpactReversal")

  @@unique([eventVersionId, sourceImpactKey])
  @@index([operatingFactId])
  @@index([operatingImpactId])
  @@index([reversesImpactId])
}

model ClearingCommandReceipt {
  id               String   @id @default(uuid())
  idempotencyKey   String   @unique
  action           String
  aggregateId      String
  expectedRevision Int
  actorUserId      String
  delegatorUserId  String?
  fingerprint      String
  resultSnapshot   Json
  createdAt        DateTime @default(now())

  @@index([aggregateId, action, createdAt])
}

// POL-215：历史接管只保存治理、来源、映射和命令因果；正式经济事实仍由 ClearingModule 追加。
// 这些记录一经写入即不可更新或删除，供重验、审计和补偿链精确复核。
// A wage-approved source can span several projects.  The atomic scope owns
// that complete closure while the already-established manifest remains a
// project child, so no arbitrary anchor project becomes the authority.
model OperatingTakeoverAtomicScopeVersion {
  id                             String   @id @default(uuid())
  scopeKind                      String
  authoritySourceRef             String
  authoritySourceFingerprint     String
  sourceClosureFingerprint       String
  reservedWageStatementVersionId String?  @unique
  candidateBaselineSha           String
  permissionSnapshotFingerprint  String
  readSetFingerprint             String
  createdByUserId                String
  createdTransactionId           BigInt   @default(dbgenerated("txid_current()"))
  createdAt                      DateTime @default(now())

  projects                     OperatingTakeoverAtomicScopeProject[]
  manifests                    OperatingTakeoverManifestVersion[]
  receipts                     OperatingTakeoverCommandReceipt[]
  historicalSummaryAuthorities HistoricalWageSummaryAuthorityVersion[]
  wageStatementReservation     WageTakeoverWageStatementReservation?
  wageProjectionEnvelopes      WageTakeoverProjectionEnvelope[]
  unresolvedWageGaps           UnresolvedWagePayableGap[]
  summaryAttestations          HistoricalWageSummaryAuthorityAttestation[]
  summaryPayableRefs           HistoricalWageSummaryPayableRef[]
  balanceReconciliations       HistoricalWageBalanceReconciliationVersion[]

  @@unique([scopeKind, authoritySourceRef, authoritySourceFingerprint, sourceClosureFingerprint], map: "OperatingTakeoverAtomicScopeVersion_authority_closure_key")
  @@index([scopeKind, createdAt])
}

// The UUID is reserved when the historical scope is prepared but there is no
// WageStatementVersion row until activation. Keeping the reservation in its
// own immutable table avoids fabricating a draft canonical aggregate merely
// to satisfy a foreign key; the envelope later proves that the confirmed
// version uses this exact UUID.
model WageTakeoverWageStatementReservation {
  id                              String   @id
  atomicScopeVersionId            String   @unique
  targetWageStatementId           String
  expectedCurrentRevision         Int
  reservedRevision                Int
  versionKind                     String
  priorConfirmedVersionId         String?
  priorSourceVersionId            String?
  sourceDeltaFingerprint          String
  canonicalRootClosureFingerprint String
  createdAt                       DateTime @default(now())

  atomicScope OperatingTakeoverAtomicScopeVersion @relation(fields: [atomicScopeVersionId], references: [id], onDelete: Restrict)
  mappings    OperatingTakeoverRowMapping[]
  envelopes   WageTakeoverProjectionEnvelope[]    @relation("WageTakeoverProjectionEnvelopeReservation")

  @@unique([id, atomicScopeVersionId], map: "WageTakeoverWageStatementReservation_id_scope_key")
  @@unique([targetWageStatementId, reservedRevision], map: "WageTakeoverWageStatementReservation_target_revision_key")
}

model OperatingTakeoverAtomicScopeProject {
  id                   String   @id @default(uuid())
  atomicScopeVersionId String
  projectId            String
  manifestVersionId    String   @unique
  createdTransactionId BigInt   @default(dbgenerated("txid_current()"))
  createdAt            DateTime @default(now())

  scope    OperatingTakeoverAtomicScopeVersion @relation(fields: [atomicScopeVersionId], references: [id], onDelete: Restrict)
  manifest OperatingTakeoverManifestVersion    @relation(fields: [manifestVersionId], references: [id], onDelete: Restrict)

  @@unique([atomicScopeVersionId, projectId], map: "OperatingTakeoverAtomicScopeProject_scope_project_key")
  @@unique([atomicScopeVersionId, manifestVersionId], map: "OperatingTakeoverAtomicScopeProject_scope_manifest_key")
}

model OperatingTakeoverManifestVersion {
  id                            String   @id @default(uuid())
  projectId                     String
  atomicScopeVersionId          String?
  adapterKind                   String   @default("construction_enterprise_clearing")
  manifestNo                    String
  version                       Int      @default(1)
  status                        String   @default("prepared")
  sourceScopeFingerprint        String
  mapperName                    String
  mapperVersion                 Int
  schemaVersion                 Int
  candidateBaselineSha          String
  permissionSnapshotFingerprint String
  readSetFingerprint            String
  manifestFingerprint           String
  createdByUserId               String
  createdAt                     DateTime @default(now())

  rows               OperatingTakeoverRowMapping[]
  receipts           OperatingTakeoverCommandReceipt[]
  atomicScope        OperatingTakeoverAtomicScopeVersion? @relation(fields: [atomicScopeVersionId], references: [id], onDelete: Restrict)
  atomicScopeProject OperatingTakeoverAtomicScopeProject?
  wageEnvelopes      WageTakeoverProjectionEnvelope[]     @relation("WageTakeoverProjectionEnvelopeManifest")
  wageEnvelopeScopes WageTakeoverProjectionEnvelope[]     @relation("WageTakeoverProjectionEnvelopeManifestScope")
  unresolvedWageGaps UnresolvedWagePayableGap[]

  @@unique([projectId, manifestNo], map: "OperatingTakeoverManifestVersion_project_manifest_key")
  @@unique([projectId, manifestFingerprint], map: "OperatingTakeoverManifestVersion_project_fingerprint_key")
  @@unique([atomicScopeVersionId, id], map: "OperatingTakeoverManifestVersion_scope_manifest_key")
  @@index([projectId, status, createdAt])
  @@index([atomicScopeVersionId, projectId])
}

model OperatingTakeoverRowMapping {
  id                                      String                                 @id @default(uuid())
  manifestVersionId                       String
  projectId                               String
  adapterKind                             String                                 @default("construction_enterprise_clearing")
  rowNo                                   Int
  sourceType                              String
  sourceBusinessId                        String
  sourceVersion                           Int
  sourceFingerprint                       String
  sourceCoordinate                        String
  normalizedRowHash                       String
  amountCents                             BigInt
  evidenceLevel                           String
  coverageKind                            String?
  coverageKey                             String?
  periodStart                             DateTime?                              @db.Date
  entryKind                               String
  mappingDecision                         String
  conflictGroupKey                        String
  adjustmentTargetRef                     String?
  sourceDiscriminator                     String?
  governedSubjectKey                      String?
  authorityCategory                       String?
  authoritySnapshotRef                    String?
  authorityFingerprint                    String?
  authorityVersionId                      String?
  authorityLineId                         String?
  authorityLineFingerprint                String?
  obligationId                            String?
  authoritativeGrossCapCents              BigInt?
  currencyCode                            String?
  wageApprovedSourceVersionId             String?
  wageStatementReservationId              String?
  historicalWageSummaryAuthorityVersionId String?
  authoritySnapshot                       Json
  legacySourceSnapshot                    Json
  readSetSnapshot                         Json
  mappingFingerprint                      String
  createdAt                               DateTime                               @default(now())
  manifest                                OperatingTakeoverManifestVersion       @relation(fields: [manifestVersionId], references: [id], onDelete: Restrict)
  authorityVersion                        AffiliateClearingAuthorityVersion?     @relation("OperatingTakeoverRowMappingAuthorityVersion", fields: [authorityVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignedWageLine                        AssignedWageAuthorityLine?             @relation("OperatingTakeoverRowMappingAssignedWageLine", fields: [authorityVersionId, authorityLineId], references: [authorityVersionId, id], onDelete: Restrict, onUpdate: Restrict)
  guaranteeObligation                     GuaranteeObligationVersion?            @relation("OperatingTakeoverRowMappingGuaranteeObligation", fields: [authorityVersionId, obligationId], references: [authorityVersionId, obligationId], onDelete: Restrict, onUpdate: Restrict)
  wageStatementReservation                WageTakeoverWageStatementReservation?  @relation(fields: [wageStatementReservationId], references: [id], onDelete: Restrict)
  wageApprovedSourceVersion               WageApprovedSourceVersion?             @relation("OperatingTakeoverRowMappingWageSource", fields: [wageApprovedSourceVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  historicalWageSummaryAuthority          HistoricalWageSummaryAuthorityVersion? @relation("OperatingTakeoverRowMappingWageSummary", fields: [historicalWageSummaryAuthorityVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  wageProjectionEnvelope                  WageTakeoverProjectionEnvelope?        @relation("WageTakeoverProjectionEnvelopeMapping")
  wageProjectionEnvelopeScopes            WageTakeoverProjectionEnvelope[]       @relation("WageTakeoverProjectionEnvelopeMappingScope")
  historicalWageSummaryPayableRefs        HistoricalWageSummaryPayableRef[]
  unresolvedWageGap                       UnresolvedWagePayableGap?
  wageLegacyImpactBridges                 WageTakeoverLegacyImpactBridge[]
  bridges                                 OperatingTakeoverLegacySourceBridge[]
