  auditRequestId          String
  createdTransactionId    BigInt
  createdBackendPid       Int
  createdAt               DateTime @default(now())

  @@index([targetType, createdAt])
}

// A FundExecution is the immutable account-layer fact for quarantine,
// resolution, refund, or returned-payment handling. Resolution adds a case and
// shared allocations to this same fact; it never creates a second execution.
model FundExecution {
  id                         String   @id @default(uuid())
  idempotencyKey             String   @unique
  executionKind              String   @default("bank_transaction")
  direction                  String
  amountCents                BigInt
  currencyCode               String   @default("CNY")
  occurredAt                 DateTime
  reversesPaymentExecutionId String?
  reversesFundExecutionId    String?
  payloadFingerprint         String
  createdByUserId            String
  handledByUserId            String
  paymentExecutedByUserId    String
  auditAction                String
  auditRequestId             String
  createdTransactionId       BigInt
  createdBackendPid          Int
  createdAt                  DateTime @default(now())

  @@index([direction, occurredAt])
  @@index([reversesPaymentExecutionId], map: "FundExecution_reverses_payment_idx")
  @@index([reversesFundExecutionId], map: "FundExecution_reverses_fund_idx")
}

// Case lifecycle is append-only: every state is a new revision in one caseKey
// chain. A returned state may only be followed by a new draft successor.
model FundExecutionCase {
  id                             String    @id @default(uuid())
