// POL-13D v7: a server-issued, immutable observation of one verified bank
// transaction. It freezes the complete active payer-verification authority
// together with the transaction amount, direction, time, and source identity.
model VerifiedBankTransactionObservation {
  id                                String   @id @default(uuid())
  reference                         String   @unique
  payerVerificationId               String
  payerVerificationReference        String
  holderCompanyEntityId             String
  holderNameSnapshot                String
  holderCreditCodeSnapshot          String
  verificationReference             String
  verifiedByUserId                  String
  verifiedAt                        DateTime
  verificationEvidenceFileId        String
  verificationEvidenceContentSha256 String
  verificationSourceType            String
  verificationSourceRecordId        String
  verificationIssuedByDatabaseRole  String
  transactionSourceType             String
  transactionSourceId               String
  transactionSourceIdentity         String   @unique
  transactionEvidenceFileId         String
  transactionEvidenceContentSha256  String
  transactionExecutedByUserId       String
  amountCents                       BigInt
  currencyCode                      String   @default("CNY")
  direction                         String
  occurredAt                        DateTime
  payloadFingerprint                String
  createdByUserId                   String
  auditAction                       String
  auditRequestId                    String
  createdTransactionId              BigInt
  createdBackendPid                 Int
  createdAt                         DateTime @default(now())

  @@unique([transactionSourceType, transactionSourceId], map: "VerifiedBankTransactionObservation_source_key")
  @@index([payerVerificationId])
  @@index([holderCompanyEntityId, occurredAt])
  @@index([verificationEvidenceFileId])
}

