generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid())
  phone              String?   @unique
  name               String
  departmentId       String?
  wxOpenid           String?   @unique
  passwordHash       String?
  mustChangePassword Boolean   @default(true)
  lastLoginAt        DateTime?
  isActive           Boolean   @default(true)
  signatureFileId    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([departmentId])
}

// 我方公司主体字典：合同签订时选择其一，名称快照进合同。
model CompanyEntity {
  id                      String   @id @default(uuid())
  name                    String
  unifiedSocialCreditCode String?
  registeredAddress       String?
  dataStatus              String   @default("legacy_incomplete")
  currentVersionNo        Int      @default(0)
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model CompanyEntityVersion {
  id                      String   @id @default(uuid())
  companyEntityId         String
  versionNo               Int
  name                    String
  unifiedSocialCreditCode String?
  registeredAddress       String?
  isActive                Boolean
  action                  String
  actorUserId             String?
  actorRoleKey            String?
  createdAt               DateTime @default(now())

  @@unique([companyEntityId, versionNo])
  @@index([name])
  @@index([unifiedSocialCreditCode])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  parentId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model Position {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserPosition {
  id         String   @id @default(uuid())
  userId     String
  positionId String
  projectId  String?
  createdAt  DateTime @default(now())

  @@unique([userId, positionId, projectId])
}

model Project {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectMember {
  id          String   @id @default(uuid())
  projectId   String
  userId      String
  positionKey String
  createdAt   DateTime @default(now())

  @@unique([projectId, userId, positionKey])
}

// 项目花名册归属仅控制人员归属与项目可见性，不授予任何项目业务岗位。
model ProjectRosterMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model Contract {
  id                        String    @id @default(uuid())
  projectId                 String
  source                    String    @default("system")
  code                      String?   @unique
  name                      String
  counterparty              String
  companyEntityId           String?
  companyEntityName         String?
  contractTypeKey           String?
  ownerUserId               String?
  businessScenarioId        String?
  scenarioTemplateMappingId String?
  scenarioSnapshot          Json?
  temporaryCode             String?   @unique
  voidedAt                  DateTime?
  voidedReason              String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([businessScenarioId])
  @@index([scenarioTemplateMappingId])
}

model ContractVersion {
  id                                     String    @id @default(uuid())
  contractId                             String
  versionNo                              Int
  changeType                             String
  status                                 String
  amountCents                            BigInt
  baseVersionId                          String?
  supersedesVersionId                    String?
  changeReason                           String?
  changeDirection                        String?
  changeAmountCents                      BigInt?
  originalBaseAmountCents                BigInt?
  cumulativeIncreaseCents                BigInt    @default(0)
  cumulativeDecreaseCents                BigInt    @default(0)
  amountLimitType                        String    @default("capped")
  effectiveAt                            DateTime?
  businessTemplateVersionId              String?
  layoutTemplateVersionId                String?
  draftRevision                          Int       @default(1)
  pricingNature                          String    @default("fixed_total")
  amountSource                           String    @default("manual")
  amountAdjustmentReason                 String?
  invoiceType                            String?
  taxMode                                String    @default("single_rate")
  defaultTaxRatePercent                  Decimal?  @db.Decimal(9, 6)
  taxFactStatus                          String    @default("unconfirmed")
  taxFactSource                          String?
  taxFactExplanation                     String?
  taxFactEvidenceFileId                  String?
  taxFactRevision                        Int       @default(0)
  taxFactsFrozenAt                       DateTime?
  contractGovernanceVersion              Int?
  companyEntityIdSnapshot                String?
  companyEntityVersionId                 String?
  companyEntityNameSnapshot              String?
  companyEntityCreditCodeSnapshot        String?
  companyEntityRegisteredAddressSnapshot String?
  draftData                              Json
  templateSnapshot                       Json
  clauseSnapshot                         Json
  readinessSnapshot                      Json?
  abandonedAt                            DateTime?
  abandonedByUserId                      String?
  abandonReason                          String?
  createdAt                              DateTime  @default(now())
  updatedAt                              DateTime  @updatedAt

  @@unique([contractId, versionNo])
  @@index([baseVersionId])
  @@index([supersedesVersionId])
  @@index([companyEntityIdSnapshot])
  @@index([companyEntityVersionId])
  @@index([status, updatedAt])
}

model ContractTaxFactRevision {
  id                      String    @id @default(uuid())
  projectId               String
  contractId              String
  contractVersionId       String
  revisionNo              Int
  kind                    String
  status                  String    @default("draft")
  invoiceType             String?
  taxMode                 String?
  defaultTaxRatePercent   Decimal?  @db.Decimal(9, 6)
  source                  String?
  confirmationExplanation String?
  evidenceFileId          String?
  rowFacts                Json
  beforeSnapshot          Json
  createdByUserId         String
  submittedByUserId       String?
  submittedAt             DateTime?
  financeReviewedByUserId String?
  financeReviewedAt       DateTime?
  financeReviewComment    String?
  confirmedByUserId       String?
  confirmedAt             DateTime?
  contractReviewComment   String?
  abandonedAt             DateTime?
  abandonedByUserId       String?
  abandonReason           String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([contractVersionId, revisionNo])
  @@index([projectId, status])
  @@index([contractVersionId, status])
  @@index([status, updatedAt])
}

model ContractTakeover {
  id                                    String                 @id @default(uuid())
  projectId                             String
  takeoverBatchId                       String?
  importRowNo                           Int?
  contractId                            String
  contractVersionId                     String                 @unique
  paymentTermsVersionId                 String
  takeoverLevel                         String
  suggestedTakeoverLevel                String?
  takeoverLevelAdjustmentReason         String?
  takeoverStatus                        String
  lifecycleStatus                       String
  signedAt                              DateTime
  historicalSettledCents                BigInt                 @default(0)
  historicalApprovalPendingPaymentCents BigInt                 @default(0)
  historicalApprovedPendingPaymentCents BigInt                 @default(0)
  historicalPaidCents                   BigInt                 @default(0)
  historicalProxyPaidCents              BigInt                 @default(0)
  historicalAdvancePaidCents            BigInt                 @default(0)
  historicalAdvanceDeductedCents        BigInt                 @default(0)
  historicalRetentionWithheldCents      BigInt                 @default(0)
  historicalRetentionReleasedCents      BigInt                 @default(0)
  otherConfirmedOccupancyCents          BigInt                 @default(0)
  balanceSourceSummary                  String?
  evidenceSummary                       String?
  takeoverCutoffDate                    DateTime?
  responsibleUserId                     String?
  reviewComment                         String?
  acceptanceConclusion                  String?
  createdByUserId                       String
  submittedByUserId                     String?
  submittedAt                           DateTime?
  confirmedByUserId                     String?
  confirmedAt                           DateTime?
  historicalBalanceConfirmedByUserId    String?
  historicalBalanceConfirmedAt          DateTime?
  abandonedAt                           DateTime?
  abandonedByUserId                     String?
  abandonReason                         String?
  createdAt                             DateTime               @default(now())
  updatedAt                             DateTime               @updatedAt
  takeoverBatch                         ContractTakeoverBatch? @relation(fields: [takeoverBatchId], references: [id])

  @@unique([takeoverBatchId, importRowNo])
  @@index([projectId, takeoverStatus])
  @@index([takeoverBatchId])
  @@index([contractId])
  @@index([contractVersionId])
  @@index([takeoverStatus, updatedAt])
}

model ContractTakeoverBatch {
  id                   String             @id @default(uuid())
  projectId            String
  batchNo              String
  status               String
  takeoverCutoffDate   DateTime
  responsibleUserId    String
  reviewComment        String
  acceptanceConclusion String
  importFingerprint    String
  totalRows            Int                @default(0)
  readyRows            Int                @default(0)
  blockedRows          Int                @default(0)
  warningRows          Int                @default(0)
  createdCount         Int                @default(0)
  skippedCount         Int                @default(0)
  createdByUserId      String
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  takeovers            ContractTakeover[]

  @@unique([projectId, batchNo])
  @@unique([projectId, importFingerprint])
  @@index([projectId, status])
}

model ContractTakeoverCorrection {
  id                    String    @id @default(uuid())
  projectId             String
  takeoverId            String
  correctionType        String
  status                String    @default("confirmed")
  targetCompanyEntityId String?
  beforeSnapshot        Json
  afterSnapshot         Json
  reason                String
  responsibleUserId     String
  attachmentFileId      String
  createdByUserId       String
  submittedByUserId     String?
  submittedAt           DateTime?
  reviewedByUserId      String?
  reviewedAt            DateTime?
  reviewComment         String?
  createdAt             DateTime  @default(now())

  @@index([projectId, takeoverId, createdAt])
  @@index([takeoverId])
  @@index([takeoverId, correctionType, status])
}

model PaymentTermsVersion {
  id                String   @id @default(uuid())
  contractId        String
  contractVersionId String
  versionNo         Int
  status            String
  originalText      String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([contractId, versionNo])
}

model PaymentTermsStage {
  id                            String           @id @default(uuid())
  paymentTermsVersionId         String
  name                          String
  stageType                     String           @default("progress")
  basis                         String
  ratioBps                      Int?
  fixedAmountCents              BigInt?
  triggerAnchor                 String           @default("settlement_effective")
  triggerEvent                  String
  dueDays                       Int
  advanceDeductionMode          String           @default("none")
  advanceDeductionRatioBps      Int?
  advanceDeductionStartRatioBps Int?
  requiresInvoice               Boolean          @default(false)
  allowsEarlyPayment            Boolean          @default(false)
  allowsInstallments            Boolean          @default(true)
  retentionBps                  Int?
  originalText                  String
  createdAt                     DateTime         @default(now())
  paymentRequests               PaymentRequest[] @relation("PaymentRequestFrozenStage")

  @@unique([id, paymentTermsVersionId], map: "PaymentTermsStage_id_paymentTermsVersionId_key")
}

model ContractArchiveFile {
  id                String    @id @default(uuid())
  contractVersionId String
  fileId            String
  uploadedByUserId  String
  confirmedByUserId String?
  confirmedAt       DateTime?
  status            String
  createdAt         DateTime  @default(now())
}

model ContractFormalFile {
  id                   String    @id @default(uuid())
  contractVersionId    String
  purpose              String
  fileId               String
  contentSha256        String
  pageCount            Int
  sourceRevision       Int
  status               String
  uploadedByUserId     String
  supersedesId         String?
  invalidatedAt        DateTime?
  invalidationReason   String?
  declarationSnapshot  Json
  declaredByUserId     String
  declaredAt           DateTime
  confirmedByUserId    String?
  confirmedAt          DateTime?
  confirmationSnapshot Json?
  createdAt            DateTime  @default(now())

  @@index([contractVersionId, purpose, status])
  @@index([fileId])
  @@index([supersedesId])
}

model ContractAuthorization {
  id                      String    @id @default(uuid())
  originContractVersionId String
  side                    String
  grantorName             String
  agentName               String
  scopeSummary            String
  fileId                  String
  contentSha256           String
  pageCount               Int
  status                  String
  supersedesId            String?
  invalidatedAt           DateTime?
  invalidationReason      String?
  uploadedByUserId        String
  createdAt               DateTime  @default(now())

  @@index([originContractVersionId, side, status])
  @@index([fileId])
  @@index([supersedesId])
}

model ContractVersionAuthorizationLink {
  id                          String   @id @default(uuid())
  contractVersionId           String
  side                        String
  required                    Boolean
  authorizationId             String?
  reusedFromContractVersionId String?
  createdAt                   DateTime @default(now())

  @@unique([contractVersionId, side])
  @@index([authorizationId])
  @@index([reusedFromContractVersionId])
}

model ContractSealTask {
  id                 String    @id @default(uuid())
  contractVersionId  String
  approvalInstanceId String    @unique
  handlerUserId      String
  status             String
  approvedByUserId   String?
  approvedAt         DateTime?
  completedByUserId  String?
  completedAt        DateTime?
  cancelledByUserId  String?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status, handlerUserId])
  @@index([contractVersionId, status])
}

model SettlementDraft {
  id                                String    @id @default(uuid())
  projectId                         String
  contractId                        String
  contractVersionId                 String
  paymentTermsVersionId             String
  settlementTemplateVersionId       String?
  code                              String
  periodLabel                       String
  isFinal                           Boolean   @default(false)
  finalCumulativeAmountCents        BigInt?
  lines                             Json
  revision                          Int       @default(1)
  status                            String    @default("draft")
  ownerUserId                       String
  governanceVersion                 Int?
  fieldReviewerUserId               String?
  fieldReviewerRoleKey              String?
  finalScopeCompleted               Boolean?
  finalPriorSettlementsIncluded     Boolean?
  finalNoOutstandingSettlements     Boolean?
  finalWithinContractCap            Boolean?
  finalNoFurtherOrdinarySettlements Boolean?
  submittedSettlementId             String?   @unique
  submittedAt                       DateTime?
  abandonedAt                       DateTime?
  abandonedByUserId                 String?
  abandonReason                     String?
  createdAt                         DateTime  @default(now())
  updatedAt                         DateTime  @updatedAt

  @@index([projectId, ownerUserId, status, updatedAt])
  @@index([contractVersionId, status])
  @@index([status, updatedAt])
}

model Settlement {
  id                                String   @id @default(uuid())
  projectId                         String
  contractId                        String
  contractVersionId                 String
  paymentTermsVersionId             String
  code                              String   @unique
  periodLabel                       String
  status                            String
  amountCents                       BigInt
  finalCumulativeAmountCents        BigInt?
  payableAmountCents                BigInt
  paidAmountCents                   BigInt   @default(0)
  sourceType                        String   @default("system")
  sourceTakeoverId                  String?  @unique
  settlementTemplateVersionId       String?
  isFinal                           Boolean  @default(false)
  invoiceTypeSnapshot               String?
  taxFactRevisionSnapshot           Int?
  governanceVersion                 Int?
  fieldReviewerUserId               String?
  fieldReviewerRoleKey              String?
  preparedByUserId                  String?
  preparerSignatureFileId           String?
  preparerSignatureSha256           String?
  finalScopeCompleted               Boolean?
  finalPriorSettlementsIncluded     Boolean?
  finalNoOutstandingSettlements     Boolean?
  finalWithinContractCap            Boolean?
  finalNoFurtherOrdinarySettlements Boolean?
  createdAt                         DateTime @default(now())
  updatedAt                         DateTime @updatedAt

  @@index([settlementTemplateVersionId])
}

model SettlementSignedDocument {
  id                    String    @id @default(uuid())
  settlementId          String?
  settlementDraftId     String?
  purpose               String
  fileId                String
  contentSha256         String
  pageCount             Int
  sourceRevision        Int
  businessSnapshotToken String
  approvalActionSetHash String?
  status                String    @default("active")
  generationStatus      String
  declarationSnapshot   Json?
  declaredByUserId      String?
  declaredAt            DateTime?
  invalidatedAt         DateTime?
  invalidationReason    String?
  uploadedByUserId      String?
  generatedByUserId     String?
  confirmedByUserId     String?
  confirmedAt           DateTime?
  supersedesId          String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([settlementId, purpose, status])
  @@index([settlementDraftId, purpose, status])
  @@index([fileId])
  @@index([supersedesId])
}

model SettlementSignedDocumentGenerationClaim {
  id                    String   @id @default(uuid())
  settlementId          String   @unique
  claimToken            String   @unique
  sourceRevision        Int
  originalDocumentId    String
  originalContentSha256 String
  businessSnapshotToken String
  approvalActionSetHash String
  status                String   @default("pending")
  requestedByUserId     String
  claimedAt             DateTime @default(now())
  attemptCount          Int      @default(1)
  uploadedFileId        String?  @unique
  finalDocumentId       String?  @unique
  safeFailureCode       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([status, updatedAt])
}

model SettlementLine {
  id                       String   @id @default(uuid())
  settlementId             String
  contractBillRowId        String?
  sourceType               String
  name                     String
  unit                     String?
  quantity                 Decimal? @db.Decimal(24, 6)
  unitPriceCents           BigInt?
  calculationMode          String   @default("legacy")
  contractQuantitySnapshot Decimal? @db.Decimal(24, 6)
  unitPriceSnapshot        Decimal? @db.Decimal(24, 6)
  taxRatePercentSnapshot   Decimal? @db.Decimal(9, 6)
  pricingModeSnapshot      String?
  amountCents              BigInt
  taxExclusiveAmountCents  BigInt?
  taxAmountCents           BigInt?
  reason                   String?
  remark                   String?
  sortOrder                Int
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([settlementId, sortOrder])
  @@index([contractBillRowId])
}

model SettlementImport {
  id                          String    @id @default(uuid())
  projectId                   String
  contractVersionId           String
  settlementTemplateVersionId String?
  fileId                      String
  fileSha256                  String
  sourceRevision              String
  status                      String    @default("preview")
  preview                     Json
  result                      Json?
  createdByUserId             String
  appliedByUserId             String?
  appliedAt                   DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([projectId, createdAt])
  @@index([contractVersionId, createdAt])
  @@index([fileId])
  @@index([settlementTemplateVersionId])
}

model SettlementTemplate {
  id              String   @id @default(uuid())
  name            String
  code            String   @unique
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SettlementTemplateVersion {
  id                         String    @id @default(uuid())
  settlementTemplateId       String
  versionNo                  Int
  status                     String    @default("draft")
  draftRevision              Int       @default(1)
  xlsxFileId                 String
  compatibleContractTypeKeys String[]  @default([])
  compatibleAmountRoles      String[]  @default([])
  compatiblePricingModes     String[]  @default([])
  columnSchema               Json
  printRules                 Json
  evidenceRules              Json
  anomalyRules               Json
  inspectionReport           Json?
  inspectionRevision         Int?
  previewXlsxFileId          String?
  previewPdfFileId           String?
  submittedByUserId          String?
  publishedByUserId          String?
  publishedAt                DateTime?
  stoppedAt                  DateTime?
  discardedAt                DateTime?
  discardedByUserId          String?
  discardReason              String?
  changeSummary              String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@unique([settlementTemplateId, versionNo])
  @@index([status, publishedAt])
  @@index([status, updatedAt])
}

model SettlementTemplatePreviewJob {
  id                          String    @id @default(uuid())
  settlementTemplateVersionId String
  sourceRevision              Int
  status                      String    @default("queued")
  sampleData                  Json
  previewXlsxFileId           String?
  previewPdfFileId            String?
  errorMessage                String?
  createdByUserId             String
  startedAt                   DateTime?
  completedAt                 DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([settlementTemplateVersionId, createdAt])
}

model SettlementArchiveFile {
  id                String    @id @default(uuid())
  settlementId      String
  fileId            String
  uploadedByUserId  String
  confirmedByUserId String?
  confirmedAt       DateTime?
  status            String
  createdAt         DateTime  @default(now())
}

model PaymentRequest {
  id                    String             @id @default(uuid())
  projectId             String
  settlementId          String?
  sourceType            String             @default("settlement")
  contractId            String
  contractVersionId     String
  paymentTermsVersionId String
  paymentTermsStageId   String?
  code                  String             @unique
  status                String
  requestedAmountCents  BigInt
  approvedAmountCents   BigInt?
  paidAmountCents       BigInt             @default(0)
  dueDate               DateTime?
  abandonedAt           DateTime?
  abandonedByUserId     String?
  abandonReason         String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  paymentTermsStage     PaymentTermsStage? @relation("PaymentRequestFrozenStage", fields: [paymentTermsStageId, paymentTermsVersionId], references: [id, paymentTermsVersionId], onDelete: Restrict, onUpdate: Restrict)

  @@index([paymentTermsStageId], map: "PaymentRequest_paymentTermsStageId_idx")
  @@index([status, updatedAt])
}

model PaymentExecution {
  id               String   @id @default(uuid())
  paymentRequestId String
  settlementId     String?
  amountCents      BigInt
  paidAt           DateTime
  executedByUserId String
  voucherFileId    String
  createdAt        DateTime @default(now())
}

model PaymentExecutionAllocation {
  id                       String    @id @default(uuid())
  paymentExecutionId       String
  paymentRequestId         String
  projectId                String
  contractId               String
  contractVersionId        String?
  settlementId             String?
  sourceType               String
  allocationType           String
  sourceRowId              String
  paymentTermsVersionId    String
  stageType                String
  stageId                  String?
  stageName                String?
  triggerAnchor            String?
  dueDays                  Int?
  ratioBps                 Int?
  fixedAmountCents         BigInt?
  sourceEffectiveAt        DateTime?
  expectedPayableAt        DateTime?
  sourcePayableAmountCents BigInt
  amountCents              BigInt
  allocationOrder          Int
  createdByUserId          String
  createdAt                DateTime  @default(now())

  @@unique([paymentExecutionId, allocationType, allocationOrder], map: "PaymentExecutionAllocation_execution_type_order_key")
  @@unique([paymentExecutionId, allocationType, sourceRowId], map: "PaymentExecutionAllocation_execution_type_row_key")
  @@index([paymentRequestId])
  @@index([contractId])
  @@index([settlementId])
  @@index([contractId, settlementId, stageId], map: "PaymentExecutionAllocation_contract_settlement_stage_idx")
}

model SpotProcurement {
  id                   String    @id @default(uuid())
  projectId            String
  code                 String    @unique
  supplierPartyId      String?
  supplierKey          String? // legacy: new real-form applications do not select a supplier
  supplierNameSnapshot String? // legacy: new real-form applications do not select a supplier
  applicantUserId      String
  handlerUserId        String
  currentVersionId     String?
  status               String
  approvedAmountCents  BigInt? // legacy: approval amount is now frozen on the payment application
  actualCostCents      BigInt?
  closedAt             DateTime?
  voidedAt             DateTime?
  voidedByUserId       String?
  voidReason           String?
  abandonedAt          DateTime?
  abandonedByUserId    String?
  abandonReason        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([projectId, id])
  @@index([projectId, status])
  @@index([projectId, supplierKey])
  @@index([status, updatedAt])
}

model SpotProcurementVersion {
  id                              String    @id @default(uuid())
  procurementId                   String
  versionNo                       Int
  status                          String
  reason                          String
  note                            String?
  supplierPartyId                 String?
  supplierKey                     String? // legacy: actual merchant is frozen on the payment application
  supplierNameSnapshot            String? // legacy: actual merchant is frozen on the payment application
  handlerUserId                   String
  applicationDepartmentSnapshot   String
  applicationNameSnapshot         String
  purchaserNameSnapshot           String
  purchaserDepartmentId           String?
  purchaserDepartmentNameSnapshot String
  requestedArrivalAt              DateTime
  totalAmountCents                BigInt? // legacy: the A4 procurement application has no amount
  changeReason                    String?
  changeSummary                   Json?
  submittedAt                     DateTime?
  approvedAt                      DateTime?
  abandonedAt                     DateTime?
  abandonedByUserId               String?
  abandonReason                   String?
  createdByUserId                 String
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt

  @@unique([procurementId, versionNo])
  @@unique([procurementId, id])
  @@index([procurementId, status])
  @@index([status, updatedAt])
}

model SpotProcurementLine {
  id                   String   @id @default(uuid())
  versionId            String
  sortOrder            Int
  materialName         String
  specification        String?
  unit                 String
  quantity             Decimal  @db.Decimal(24, 6)
  invoiceMode          String? // legacy: expected invoice facts belong to payment lines
