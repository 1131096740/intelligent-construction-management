// POL-13B: immutable, server-checked payer proof. The ordinary payment
// request/company snapshot is the approved payer; this record is the only
// source allowed to establish the actual bank-account legal holder for a
// cross-entity relationship.
model PaymentExecutionPayerAttestation {
  id                                 String    @id @default(uuid())
  paymentExecutionId                 String    @unique
  payerVerificationId                String
  bankAccountReference               String
  holderCompanyEntityId              String
  holderNameSnapshot                 String
  holderCreditCodeSnapshot           String
  verificationReference              String
  verifiedByUserId                   String
  verifiedAt                         DateTime
  verificationEvidenceFileId         String
  verificationEvidenceContentSha256  String
  proxyAuthorizationReason           String?
  proxyAuthorizationEvidenceFileId   String?
  proxyAuthorizationEvidenceSha256   String?
  reauthorizationReference           String?
  reauthorizationApprovalInstanceId  String?
  reauthorizationApprovalActionLogId String?
  reauthorizationPaymentRequestId    String?
  reauthorizationContractVersionId   String?
  reauthorizedByUserId               String?
  reauthorizedAt                     DateTime?
  createdAt                          DateTime  @default(now())

  paymentExecution PaymentExecution @relation(fields: [paymentExecutionId], references: [id], onDelete: Restrict)

  @@index([holderCompanyEntityId])
  @@index([verificationEvidenceFileId])
  @@index([proxyAuthorizationEvidenceFileId])
  @@index([verifiedByUserId])
  @@index([payerVerificationId])
  @@index([reauthorizationApprovalActionLogId])
}

// A PaymentExecution may settle several wage creditors. This immutable bridge
// freezes the source WagePayableRef identity without making a fake single payee
// on the payment fact. The bridge is intentionally append-only; #220 consumes
// it as a read-side eligibility proof.
model PaymentExecutionWagePayableBinding {
  id                              String   @id @default(uuid())
  paymentExecutionId              String
  wagePayableRefId                String
  debtorCompanyId                 String
  debtorCompanySnapshot           Json
  projectId                       String
  projectSnapshot                 Json
  creditorSubjectType             String
  creditorUserId                  String?
  creditorBusinessPartyVersionId  String?
  creditorSubjectIdentityKey      String
  creditorNameSnapshot            String
  creditorUnifiedIdentitySnapshot String?
  creditorVersionFingerprint      String
  creditorSnapshot                Json
  amountCents                     BigInt
  currencyCode                    String   @default("CNY")
  createdByUserId                 String
  createdAt                       DateTime @default(now())

  paymentExecution PaymentExecution @relation(fields: [paymentExecutionId], references: [id], onDelete: Restrict)
  wagePayableRef   WagePayableRef   @relation(fields: [wagePayableRefId], references: [id], onDelete: Restrict)

  @@unique([paymentExecutionId, wagePayableRefId], map: "PaymentExecutionWagePayableBinding_execution_ref_key")
  @@index([wagePayableRefId])
  @@index([paymentExecutionId])
  @@index([projectId, debtorCompanyId])
}

