  createdByUserId            String
  auditRequestId             String
  createdTransactionId       BigInt
  createdBackendPid          Int
  createdAt                  DateTime @default(now())

  @@unique([executionType, executionId, lineNo], map: "ExecutionAllocationLine_execution_line_key")
  @@unique([executionType, executionId, sliceIdentity], map: "ExecutionAllocationLine_execution_slice_key")
