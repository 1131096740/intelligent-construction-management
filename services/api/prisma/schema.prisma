  @@unique([projectId, sceneKey, entityType, entityId, revision], map: "BusinessEntrySubmissionSnapshot_target_revision_key")
  @@index([projectId, sceneKey, frozenAt])
}

// POL-12A：外部已批准工资资料与月度承担单聚合。该聚合只冻结来源和分摊，
// 不在本票生成 OperatingFact、工资应付或付款事实。
model WageApprovedSourceVersion {
  id                  String   @id @default(uuid())
  employmentCompanyId String
  wageMonth           String
  periodStart         DateTime @db.Date
  periodEnd           DateTime @db.Date
  sourceType          String
  externalReference   String
  sourceVersion       String
  basisDate           DateTime @db.Date
  evidenceFileId      String
  evidenceSha256      String
  sourceFingerprint   String
  sourceSnapshot      Json
  createdByUserId     String
  createdAt           DateTime @default(now())

  evidenceFile         FileObject                         @relation("WageApprovedSourceEvidence", fields: [evidenceFileId], references: [id], onDelete: Restrict)
  statementVersions    WageStatementVersion[]
  commandReceipts      WageApprovedSourceCommandReceipt[]
  serviceBasisBindings WageServiceBasisBinding[]
  takeoverMappings     OperatingTakeoverRowMapping[]      @relation("OperatingTakeoverRowMappingWageSource")

  @@unique([employmentCompanyId, externalReference, sourceVersion], map: "WageApprovedSourceVersion_external_identity_key")
  @@index([employmentCompanyId, wageMonth, periodStart, periodEnd])
}

// 来源创建与工资承担单命令分别使用回执表，避免把来源幂等键错误地挂到尚未
// 存在的月度单据上；结果快照只保留来源 ID，不复制私有批准载荷或证据内容。
model WageApprovedSourceCommandReceipt {
  idempotencyKey   String   @id
  action           String
  aggregateId      String
  expectedRevision Int
  actorUserId      String
  fingerprint      String
  resultSnapshot   Json
  createdAt        DateTime @default(now())

  source WageApprovedSourceVersion @relation(fields: [aggregateId], references: [id], onDelete: Restrict)

  @@index([aggregateId, createdAt])
}

model WageStatement {
  id                  String   @id @default(uuid())
  employmentCompanyId String
  wageMonth           String
  currentRevision     Int      @default(0)
  createdByUserId     String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  versions        WageStatementVersion[]
  commandReceipts WageCommandReceipt[]

  @@unique([employmentCompanyId, wageMonth], map: "WageStatement_company_month_key")
}

model WageCommandReceipt {
  idempotencyKey   String   @id
  action           String
  aggregateId      String
  expectedRevision Int
  actorUserId      String
  fingerprint      String
  resultSnapshot   Json
  createdAt        DateTime @default(now())

  statement WageStatement @relation(fields: [aggregateId], references: [id], onDelete: Restrict)

  @@index([aggregateId, createdAt])
}

model WageStatementVersion {
  id                          String    @id @default(uuid())
  statementId                 String
  revision                    Int
  kind                        String    @default("base")
  status                      String    @default("draft")
  // Ordinary confirmation projects into the operating ledger. The historical
  // takeover seam is intentionally distinct: it can materialize the canonical
  // wage aggregate and payable refs, but only links pre-existing legacy
  // impacts and must never append another operating fact.
  projectionOrigin            String    @default("ordinary")
  sourceVersionId             String
  sourceSnapshot              Json
  // 仅保存工资经营 envelope 的非敏感冻结坐标；人员、金额、债权人和证据仍只留在
  // 受控工资版本/应付引用中，重放时由同一不可变矩阵重新读取。
  operatingProjectionSnapshot Json?
  createdByUserId             String
  lastEditedByUserId          String
  submittedByUserId           String?
  submittedAt                 DateTime?
  confirmedByUserId           String?
  confirmedAt                 DateTime?
  reviewReturnedByUserId      String?
  reviewReturnedAt            DateTime?
  reviewReturnReason          String?
  reviewDisposition           String?
  supersededAt                DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  statement                   WageStatement                    @relation(fields: [statementId], references: [id], onDelete: Restrict)
  sourceVersion               WageApprovedSourceVersion        @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict)
  personLines                 WagePersonLine[]
  payableRefs                 WagePayableRef[]
  takeoverProjectionEnvelopes WageTakeoverProjectionEnvelope[]

  @@unique([statementId, revision], map: "WageStatementVersion_statement_revision_key")
  @@index([sourceVersionId])
  @@index([projectionOrigin, status])
  @@index([status, updatedAt])
  @@index([reviewDisposition, reviewReturnedAt])
}

// 服务依据不是调用方提供的裸字符串：它由批准来源版本在同一串行事务中
// 固化，并由后续工资分摊行通过外键引用。
model WageServiceBasisBinding {
  id                   String   @id @default(uuid())
  sourceVersionId      String
  projectId            String
  serviceSnapshotId    String
  serviceMonth         String
  evidenceSha256       String
  authorityFingerprint String
  createdAt            DateTime @default(now())

  sourceVersion      WageApprovedSourceVersion @relation(fields: [sourceVersionId], references: [id], onDelete: Restrict)
  projectAllocations WageProjectAllocation[]

  @@unique([sourceVersionId, projectId, serviceSnapshotId], map: "WageServiceBasisBinding_source_project_service_key")
  @@index([sourceVersionId, serviceMonth])
}

model WagePersonLine {
  id                       String   @id @default(uuid())
  statementVersionId       String
  employeeId               String
  employmentSnapshotId     String
  employeeSnapshot         Json
  employmentSnapshot       Json
  periodSnapshot           Json
  positionCategorySnapshot Json
  approvedAmountCents      BigInt
  createdAt                DateTime @default(now())

  statementVersion   WageStatementVersion    @relation(fields: [statementVersionId], references: [id], onDelete: Restrict)
  costComponents     WageCostComponent[]
  creditorBreakdowns WageCreditorBreakdown[]
  projectAllocations WageProjectAllocation[]
  payableRefs        WagePayableRef[]

  @@unique([statementVersionId, employeeId, employmentSnapshotId], map: "WagePersonLine_version_employee_employment_key")
  @@index([employeeId])
}

model WageCostComponent {
  id             String   @id @default(uuid())
  personLineId   String
  componentCode  String
  amountCents    BigInt
  sourceSnapshot Json
  createdAt      DateTime @default(now())

  personLine         WagePersonLine                       @relation(fields: [personLineId], references: [id], onDelete: Restrict)
  projectAllocations WageProjectCostComponentAllocation[]

  @@unique([personLineId, componentCode], map: "WageCostComponent_person_component_key")
}

model WageCreditorBreakdown {
  id                              String   @id @default(uuid())
  personLineId                    String
  // POL-12A legacy identity remains nullable only for already-frozen versions.
  // New POL-12B writes use the explicit union below and its canonical identity key.
  creditorSubjectId               String?
  creditorSubjectType             String?
  creditorUserId                  String?
  creditorBusinessPartyVersionId  String?
  creditorSubjectIdentityKey      String?
  creditorNameSnapshot            String?
  creditorUnifiedIdentitySnapshot String?
  creditorVersionFingerprint      String?
  creditorCategory                String
  amountCents                     BigInt
  sourceSnapshot                  Json
  createdAt                       DateTime @default(now())

  personLine                   WagePersonLine                  @relation(fields: [personLineId], references: [id], onDelete: Restrict)
  creditorUser                 User?                           @relation("WageCreditorUser", fields: [creditorUserId], references: [id], onDelete: Restrict)
  creditorBusinessPartyVersion BusinessPartyVersion?           @relation("WageCreditorBusinessPartyVersion", fields: [creditorBusinessPartyVersionId], references: [id], onDelete: Restrict)
  projectAllocations           WageProjectCreditorAllocation[]
  payableRefs                  WagePayableRef[]

  @@unique([personLineId, creditorSubjectId, creditorCategory], map: "WageCreditorBreakdown_person_creditor_category_key")
  @@index([creditorUserId])
  @@index([creditorBusinessPartyVersionId])
}

model WageProjectAllocation {
  id                    String   @id @default(uuid())
  personLineId          String
  projectId             String
  serviceSnapshotId     String
  serviceBasisBindingId String
  serviceSnapshot       Json
  amountCents           BigInt
  createdAt             DateTime @default(now())

  personLine           WagePersonLine                       @relation(fields: [personLineId], references: [id], onDelete: Restrict)
  serviceBasisBinding  WageServiceBasisBinding              @relation(fields: [serviceBasisBindingId], references: [id], onDelete: Restrict)
  componentAllocations WageProjectCostComponentAllocation[]
  creditorAllocations  WageProjectCreditorAllocation[]
  payableRefs          WagePayableRef[]

  @@unique([personLineId, projectId, serviceSnapshotId], map: "WageProjectAllocation_person_project_service_key")
  @@index([projectId])
  @@index([serviceBasisBindingId])
}

// 这两张交叉矩阵是财务显式填写的冻结分配；服务层负责所有逐行、逐列与版本总额平衡，
// 数据库在这里固定其引用、唯一性和非负金额边界。
model WageProjectCostComponentAllocation {
  id                  String   @id @default(uuid())
  projectAllocationId String
  costComponentId     String
  amountCents         BigInt
  createdAt           DateTime @default(now())

  projectAllocation     WageProjectAllocation                    @relation(fields: [projectAllocationId], references: [id], onDelete: Restrict)
  costComponent         WageCostComponent                        @relation(fields: [costComponentId], references: [id], onDelete: Restrict)
  takeoverEnvelopeLinks WageTakeoverProjectionEnvelopeCostCell[]

  @@unique([projectAllocationId, costComponentId], map: "WageProjectCostComponentAllocation_project_component_key")
  @@index([costComponentId])
}

model WageProjectCreditorAllocation {
  id                  String   @id @default(uuid())
  projectAllocationId String
  creditorBreakdownId String
  amountCents         BigInt
  createdAt           DateTime @default(now())

  projectAllocation WageProjectAllocation @relation(fields: [projectAllocationId], references: [id], onDelete: Restrict)
  creditorBreakdown WageCreditorBreakdown @relation(fields: [creditorBreakdownId], references: [id], onDelete: Restrict)

  @@unique([projectAllocationId, creditorBreakdownId], map: "WageProjectCreditorAllocation_project_creditor_key")
  @@index([creditorBreakdownId])
}

// 应付引用是 #217 对经营投影的唯一追加式接口。它不记录付款或核销；#220 再以实际核销
// 计算 remainingPayable、overSettledAmount 和 reconciliation 状态。
model WagePayableRef {
  id                         String   @id @default(uuid())
  confirmedVersionId         String
  projectAllocationId        String
  creditorBreakdownId        String
  debtorCompanyId            String
  costBearingCompanyId       String
  projectId                  String
  personLineId               String
  debtorCompanySnapshot      Json
  costBearingCompanySnapshot Json
  projectSnapshot            Json
  personSnapshot             Json
  creditorSnapshot           Json
  amountCents                BigInt
  direction                  String
  adjustsPayableRefId        String?
  // A decrease is an immutable debt-side correction only.  #220 alone reads
  // real settlement facts and decides whether reconciliation is required.
  settlementRecheckRequired  Boolean  @default(false)
  createdAt                  DateTime @default(now())

  confirmedVersion         WageStatementVersion                       @relation(fields: [confirmedVersionId], references: [id], onDelete: Restrict)
  projectAllocation        WageProjectAllocation                      @relation(fields: [projectAllocationId], references: [id], onDelete: Restrict)
  creditorBreakdown        WageCreditorBreakdown                      @relation(fields: [creditorBreakdownId], references: [id], onDelete: Restrict)
  personLine               WagePersonLine                             @relation(fields: [personLineId], references: [id], onDelete: Restrict)
  adjustsPayableRef        WagePayableRef?                            @relation("WagePayableRefAdjustments", fields: [adjustsPayableRefId], references: [id], onDelete: Restrict)
  adjustments              WagePayableRef[]                           @relation("WagePayableRefAdjustments")
  paymentExecutionBindings PaymentExecutionWagePayableBinding[]
  takeoverEnvelopeLinks    WageTakeoverProjectionEnvelopePayableRef[]

  @@index([confirmedVersionId])
  @@index([projectId, debtorCompanyId])
  @@index([projectId, costBearingCompanyId])
  @@index([adjustsPayableRefId])
}

// POL-13A intentionally references an existing PaymentExecution instead of
// creating another bank-payment fact. Each confirmed allocation stores the
// exact source snapshot it consumed so later upstream corrections can derive
// the effective balance without rewriting payment history.
model PayableSettlementCase {
  id                 String    @id @default(uuid())
  paymentExecutionId String
  status             String    @default("draft")
  revision           Int       @default(1)
  supersedesCaseId   String?
  createdByUserId    String
  submittedByUserId  String?
  confirmedByUserId  String?
  createdAt          DateTime  @default(now())
  submittedAt        DateTime?
  confirmedAt        DateTime?
  updatedAt          DateTime  @updatedAt

  paymentExecution               PaymentExecution                  @relation(fields: [paymentExecutionId], references: [id], onDelete: Restrict, map: "PayableSettlementCase_payment_execution_fkey")
  allocations                    PayableSettlementAllocation[]
  receipts                       PayableSettlementCommandReceipt[]
  interEntityRelationshipEntries InterEntityRelationshipEntry[]
  supersedesCase                 PayableSettlementCase?            @relation("PayableSettlementCaseRevision", fields: [supersedesCaseId], references: [id], onDelete: Restrict, map: "PayableSettlementCase_supersedes_case_fkey")
  revisions                      PayableSettlementCase[]           @relation("PayableSettlementCaseRevision")

  @@unique([paymentExecutionId, revision], map: "PayableSettlementCase_execution_revision_key")
  @@index([status, updatedAt])
  @@index([supersedesCaseId])
}

// POL-13B: append-only inter-entity relationship entries created when a
// confirmed payable settlement was paid by a different company. The root
// increase is tied to the existing PaymentExecution and settlement case;
// returns are immutable decreases that reference the root entry and never
// rewrite the supplier payable or payment fact.
model InterEntityRelationshipEntry {
  id                                    String    @id @default(uuid())
  entryKind                             String
  direction                             String
  status                                String    @default("draft")
  adjustsEntryId                        String?
  paymentExecutionId                    String?
  settlementCaseId                      String?
  fundExecutionId                       String?
  fundExecutionCaseId                   String?
  executionAllocationLineId             String?
  originalDebtorCompanyId               String
  creditorCompanyId                     String
  approvedPayerCompanyId                String
  debtorSnapshot                        Json
  creditorSnapshot                      Json
  approvedPayerSnapshot                 Json
  amountCents                           BigInt
  currencyCode                          String    @default("CNY")
  evidenceFileId                        String
  evidenceClaimId                       String?
  evidenceUploadedByUserId              String?
  evidenceContentSha256                 String?
  authorizationEvidenceFileId           String?
  authorizationEvidenceContentSha256    String?
  reauthorizationReference              String?
  reauthorizedByUserId                  String?
  reauthorizedAt                        DateTime?
  actualPayerVerificationEvidenceFileId String?
  actualPayerVerificationContentSha256  String?
  projectId                             String?
  contractId                            String?
  contractVersionId                     String?
  sourceType                            String?
  sourceAggregateId                     String?
  sourceAllocationCount                 Int?
  sourceAllocationAmountCents           BigInt?
  reason                                String?
  idempotencyKey                        String    @unique
  payloadFingerprint                    String
  createdByUserId                       String
  confirmedByUserId                     String?
  createdAt                             DateTime  @default(now())
  confirmedAt                           DateTime?

  paymentExecution PaymentExecution?                      @relation(fields: [paymentExecutionId], references: [id], onDelete: Restrict)
  settlementCase   PayableSettlementCase?                 @relation(fields: [settlementCaseId], references: [id], onDelete: Restrict)
  originalEntry    InterEntityRelationshipEntry?          @relation("InterEntityRelationshipAdjustments", fields: [adjustsEntryId], references: [id], onDelete: Restrict)
  adjustments      InterEntityRelationshipEntry[]         @relation("InterEntityRelationshipAdjustments")
  evidenceClaims   InterEntityRelationshipEvidenceClaim[] @relation("InterEntityRelationshipEvidenceClaims")

  @@unique([settlementCaseId, entryKind], map: "InterEntityRelationshipEntry_case_kind_key")
  @@index([adjustsEntryId])
  @@index([originalDebtorCompanyId, creditorCompanyId, createdAt])
  @@index([paymentExecutionId])
  @@index([settlementCaseId])
  @@index([fundExecutionId, fundExecutionCaseId])
  @@index([executionAllocationLineId])
}

// A return evidence upload is a one-time claim bound to the root relationship,
// uploader and immutable content hash. The claim is consumed in the same
// serializable transaction that confirms the append-only decrease.
model InterEntityRelationshipEvidenceClaim {
  id                  String    @id @default(uuid())
  relationshipEntryId String
  fileId              String    @unique
  uploadedByUserId    String
  contentSha256       String
  status              String    @default("pending")
  idempotencyKey      String    @unique
  createdAt           DateTime  @default(now())
  consumedAt          DateTime?
  consumedByUserId    String?

  relationshipEntry InterEntityRelationshipEntry @relation("InterEntityRelationshipEvidenceClaims", fields: [relationshipEntryId], references: [id], onDelete: Restrict)

  @@index([relationshipEntryId, status, createdAt])
  @@index([uploadedByUserId])
}

model PayableSettlementAllocation {
  id                        String   @id @default(uuid())
  settlementCaseId          String?
  paymentExecutionId        String?
  fundExecutionId           String?
  fundExecutionCaseId       String?
  executionAllocationLineId String?
  payableRef                String
  sourceType                String
  sourceAggregateId         String
  sourceLineId              String
  confirmedVersionId        String
  debtorCompanyId           String
  payeeSubjectType          String
  payeeSubjectId            String
  currencyCode              String
  beneficiaryProjectId      String
  sourceSnapshot            Json
  confirmedAmountCents      BigInt
  amountCents               BigInt
  direction                 String?
  reversalOfAllocationId    String?
  createdByUserId           String
  createdAt                 DateTime @default(now())

  settlementCase   PayableSettlementCase? @relation(fields: [settlementCaseId], references: [id], onDelete: Restrict, map: "PayableSettlementAllocation_settlement_case_fkey")
  paymentExecution PaymentExecution?      @relation(fields: [paymentExecutionId], references: [id], onDelete: Restrict, map: "PayableSettlementAllocation_payment_execution_fkey")

  @@unique([settlementCaseId, payableRef], map: "PayableSettlementAllocation_case_payable_ref_key")
  @@index([payableRef, createdAt])
  @@index([paymentExecutionId])
  @@index([fundExecutionId, fundExecutionCaseId])
  @@index([executionAllocationLineId])
  @@index([reversalOfAllocationId])
}

model PayableSettlementCommandReceipt {
  id                 String   @id @default(uuid())
  idempotencyKey     String   @unique
  payloadFingerprint String
  action             String
  settlementCaseId   String?
  responseSnapshot   Json
  createdAt          DateTime @default(now())

  settlementCase PayableSettlementCase? @relation(fields: [settlementCaseId], references: [id], onDelete: Restrict, map: "PayableSettlementCommandReceipt_settlement_case_fkey")

  @@index([settlementCaseId])
}
