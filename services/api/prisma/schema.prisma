  @@index([interEntityRelationshipEntryId])
  @@index([operatingFactId, operatingImpactEntryId])
  @@index([originalConsequenceId])
}

// POL-13C: an explicit, immutable project/company fund movement aggregate.
// The aggregate references an existing PaymentExecution when one exists; it
// never creates a second bank-payment fact.  All formal effects are carried
// by its append-only legs and relationship entries.
model FundMovement {
  id                         String    @id @default(uuid())
  kind                       String
  status                     String    @default("draft")
  revision                   Int       @default(1)
  paymentExecutionId         String?
  sourceProjectId            String
  beneficiaryProjectId       String
  sourceCompanyEntityId      String
  beneficiaryCompanyEntityId String
  paymentAmountCents         BigInt
  projectFundUsedCents       BigInt
  companyAdvanceCents        BigInt
  profitAuthorizationId      String?
  payloadFingerprint         String
  idempotencyKey             String    @unique
  createdByUserId            String
  submittedByUserId          String?
  confirmedByUserId          String?
  createdAt                  DateTime  @default(now())
  submittedAt                DateTime?
  confirmedAt                DateTime?
  updatedAt                  DateTime  @updatedAt

  paymentExecution    PaymentExecution?               @relation("FundMovementPaymentExecution", fields: [paymentExecutionId], references: [id], onDelete: Restrict)
  sourceProject       Project                         @relation("FundMovementSourceProject", fields: [sourceProjectId], references: [id], onDelete: Restrict)
  beneficiaryProject  Project                         @relation("FundMovementBeneficiaryProject", fields: [beneficiaryProjectId], references: [id], onDelete: Restrict)
  sourceCompany       CompanyEntity                   @relation("FundMovementSourceCompany", fields: [sourceCompanyEntityId], references: [id], onDelete: Restrict)
  beneficiaryCompany  CompanyEntity                   @relation("FundMovementBeneficiaryCompany", fields: [beneficiaryCompanyEntityId], references: [id], onDelete: Restrict)
  createdBy           User                            @relation("FundMovementCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  submittedBy         User?                           @relation("FundMovementSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  confirmedBy         User?                           @relation("FundMovementConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: Restrict)
  legs                FundMovementLeg[]
  relationshipEntries FundMovementRelationshipEntry[]
  receipts            FundMovementCommandReceipt[]

  // A real PaymentExecution can be projected by at most one fund movement;
  // nullable uniqueness still permits non-payment movements to omit it.
  @@unique([paymentExecutionId], map: "FundMovement_payment_execution_unique")
  @@index([status, updatedAt])
  @@index([paymentExecutionId])
  @@index([sourceProjectId, beneficiaryProjectId])
  @@index([sourceCompanyEntityId, beneficiaryCompanyEntityId])
}

// One leg owns one project's projection.  Typed source/contract snapshots
// are retained on the leg so later master-data changes cannot rewrite the
// movement's accounting context.
model FundMovementLeg {
  id                          String   @id @default(uuid())
  movementId                  String
  legNo                       Int
  role                        String
  projectId                   String
  companyEntityId             String
  counterpartyProjectId       String?
  counterpartyCompanyEntityId String?
  direction                   String
  amountCents                 BigInt
  projectFundUsedCents        BigInt
  companyAdvanceCents         BigInt
  paymentExecutionId          String?
  relationshipEntryId         String?
  sourceType                  String?
  sourceAggregateId           String?
  sourceAllocationCount       Int?
  sourceAllocationAmountCents BigInt?
  contractId                  String?
  contractVersionId           String?
  operatingFactId             String?
  sourceSnapshot              Json
  idempotencyKey              String   @unique
  createdByUserId             String
  createdAt                   DateTime @default(now())

  movement              FundMovement                    @relation(fields: [movementId], references: [id], onDelete: Restrict)
  project               Project                         @relation("FundMovementLegProject", fields: [projectId], references: [id], onDelete: Restrict)
  company               CompanyEntity                   @relation("FundMovementLegCompany", fields: [companyEntityId], references: [id], onDelete: Restrict)
  paymentExecution      PaymentExecution?               @relation("FundMovementLegPaymentExecution", fields: [paymentExecutionId], references: [id], onDelete: Restrict)
  operatingFact         OperatingFact?                  @relation("FundMovementLegOperatingFact", fields: [operatingFactId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy             User                            @relation("FundMovementLegCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  relationshipEntries   FundMovementRelationshipEntry[] @relation("FundMovementLegRelationship")
  relationshipEntryById FundMovementRelationshipEntry?  @relation("FundMovementLegPointer", fields: [relationshipEntryId], references: [id], onDelete: Restrict)

  @@unique([movementId, legNo], map: "FundMovementLeg_movement_leg_no_key")
  @@unique([relationshipEntryId], map: "FundMovementLeg_relationship_entry_unique")
  @@unique([operatingFactId], map: "FundMovementLeg_operating_fact_unique")
  @@index([projectId, createdAt])
  @@index([movementId, role])
  @@index([paymentExecutionId])
}

// Project-internal receivable/payable is separate from POL-13B's legal-entity
// proxy relationship.  It is append-only and carries source, contract and
// allocation snapshots for cross-company/project movements.
model FundMovementRelationshipEntry {
  id                          String    @id @default(uuid())
  movementId                  String
  legId                       String?
  entryKind                   String
  direction                   String
  status                      String    @default("draft")
  adjustsEntryId              String?
  sourceProjectId             String
  beneficiaryProjectId        String
  debtorCompanyEntityId       String
  creditorCompanyEntityId     String
  sourceType                  String?
  sourceAggregateId           String?
  sourceAllocationCount       Int?
  sourceAllocationAmountCents BigInt?
  contractId                  String?
  contractVersionId           String?
  amountCents                 BigInt
  currencyCode                String    @default("CNY")
  sourceSnapshot              Json
  payloadFingerprint          String
  idempotencyKey              String    @unique
  createdByUserId             String
  confirmedByUserId           String?
  createdAt                   DateTime  @default(now())
  confirmedAt                 DateTime?

  movement           FundMovement                    @relation(fields: [movementId], references: [id], onDelete: Restrict)
  leg                FundMovementLeg?                @relation("FundMovementLegRelationship", fields: [legId], references: [id], onDelete: Restrict)
  project            Project                         @relation("FundMovementRelationshipSourceProject", fields: [sourceProjectId], references: [id], onDelete: Restrict)
  beneficiaryProject Project                         @relation("FundMovementRelationshipBeneficiaryProject", fields: [beneficiaryProjectId], references: [id], onDelete: Restrict)
  debtorCompany      CompanyEntity                   @relation("FundMovementRelationshipDebtorCompany", fields: [debtorCompanyEntityId], references: [id], onDelete: Restrict)
  creditorCompany    CompanyEntity                   @relation("FundMovementRelationshipCreditorCompany", fields: [creditorCompanyEntityId], references: [id], onDelete: Restrict)
  createdBy          User                            @relation("FundMovementRelationshipCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  confirmedBy        User?                           @relation("FundMovementRelationshipConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: Restrict)
  legPointer         FundMovementLeg?                @relation("FundMovementLegPointer")
  originalEntry      FundMovementRelationshipEntry?  @relation("FundMovementRelationshipAdjustments", fields: [adjustsEntryId], references: [id], onDelete: Restrict)
  adjustments        FundMovementRelationshipEntry[] @relation("FundMovementRelationshipAdjustments")

  @@index([movementId, status])
  @@index([sourceProjectId, beneficiaryProjectId, createdAt])
  @@index([debtorCompanyEntityId, creditorCompanyEntityId, createdAt])
  @@index([adjustsEntryId])
}

model FundMovementCommandReceipt {
  id                 String   @id @default(uuid())
  idempotencyKey     String   @unique
  payloadFingerprint String
  action             String
  movementId         String?
  responseSnapshot   Json
  createdAt          DateTime @default(now())

