NODE_ENV=production
PORT=3000
WEB_ORIGIN=https://jgzg.site
DATABASE_URL=postgresql://jiangkong_app:replace-with-password@127.0.0.1:5432/jiangkong

JWT_ACCESS_SECRET=replace-with-64-random-chars
JWT_REFRESH_SECRET=replace-with-64-random-chars
FILE_DOWNLOAD_SECRET=replace-with-64-random-chars

FILE_STORAGE_DRIVER=cos
COS_SECRET_ID=replace-with-tencent-cos-secret-id
COS_SECRET_KEY=replace-with-tencent-cos-secret-key
COS_BUCKET=replace-with-private-bucket
COS_REGION=ap-guangzhou
FILE_UPLOAD_MAX_BYTES=104857600

DOC_CONVERTER_COMMAND=soffice
DOC_ALLOWED_FONTS=方正小标宋简体,仿宋_GB2312,楷体_GB2312,Noto Sans CJK SC,宋体,仿宋,黑体
