NODE_ENV=production
PORT=3000
WEB_ORIGIN=https://jgzg.site
DATABASE_URL=postgresql://jiangkong_runtime:replace-with-runtime-password@127.0.0.1:5432/jiangkong
OPERATING_LEDGER_RUNTIME_ROLE=jiangkong_runtime
# Owner-only DATABASE_MIGRATION_URL must live in /etc/jiangkong/db-migration.env
# (root:root, mode 0600); never add it to this runtime EnvironmentFile.
# Must match the private hash provisioned by the database-owner role. Never commit a real value.
OPERATING_LEDGER_DB_WRITE_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# 两项均至少 32 字符，彼此独立，且不得复用 JWT、下载或数据库写入密钥。
FUND_EXECUTION_BANK_OBSERVATION_SELECTION_SECRET=replace-with-an-independent-random-secret-of-at-least-32-characters
FUND_EXECUTION_AXIS_BUSINESS_SELECTION_SECRET=replace-with-another-independent-random-secret-of-at-least-32-characters

JWT_ACCESS_SECRET=replace-with-64-random-chars
JWT_REFRESH_SECRET=replace-with-64-random-chars
# 至少 32 个字符，使用独立高强度随机值，不得与 JWT 密钥共用。
FILE_DOWNLOAD_SECRET=replace-with-64-random-chars
# 新账号统一初始密码。只在生产受控环境文件配置，严禁提交真实值。
INITIAL_USER_TEMPORARY_PASSWORD=

# 短信资质、签名、模板和运营商报备全部通过后再启用。关闭时使用人工核验和管理员重置。
SMS_ENABLED=false
# 使用独立的短信发送身份，不复用 COS 密钥；真实值只写服务器私有环境文件。
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_SDK_APP_ID=
SMS_SIGN_NAME=
# 验证码模板包含两个变量：验证码、有效分钟数。
SMS_TEMPLATE_ID=
# 至少 32 字符的独立随机密钥，用于验证码摘要，不复用其他密钥。
SMS_CODE_SECRET=

FILE_STORAGE_DRIVER=cos
COS_SECRET_ID=replace-with-tencent-cos-secret-id
COS_SECRET_KEY=replace-with-tencent-cos-secret-key
# 格式示例：example-bucket-1250000000；仓库不保存真实桶名。
COS_BUCKET=replace-with-private-bucket-appid
# 格式示例：ap-chengdu；仓库不保存真实 region。
COS_REGION=replace-with-cos-region
# 必须是 1..104857600 的纯十进制正整数（最大 100 MiB）。
FILE_UPLOAD_MAX_BYTES=104857600

DOC_CONVERTER_COMMAND=soffice
DOC_ALLOWED_FONTS=方正小标宋简体,仿宋_GB2312,楷体_GB2312,Noto Sans CJK SC,宋体,仿宋,黑体

# 正式全项目模式使用单独的 "*"，新项目自动纳入，仍校验岗位和项目启用状态。
# 显式留空可暂停全部项目新零采；也兼容英文逗号分隔的限定项目 ID。
SPOT_PROCUREMENT_PILOT_PROJECT_IDS=*
