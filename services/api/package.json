{
  "name": "@jiangkong/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node ../../scripts/pnpm-workspace.mjs --filter @jiangkong/shared-domain build",
    "dev": "nest start --watch",
    "prebuild": "node ../../scripts/pnpm-workspace.mjs --filter @jiangkong/shared-domain build",
    "build": "nest build",
    "prisma": "prisma",
    "preseed": "node ../../scripts/pnpm-workspace.mjs --filter @jiangkong/api build",
    "seed": "prisma db seed",
    "preverify:core-flow": "node ../../scripts/pnpm-workspace.mjs --filter @jiangkong/api build",
    "verify:core-flow": "node prisma/verify-core-flow.cjs",
    "preverify:money-bigint:local": "node ../../scripts/pnpm-workspace.mjs --filter @jiangkong/api build",
    "verify:money-bigint:local": "node prisma/run-money-bigint-local.cjs",
    "preverify:contract-workbench": "node ../../scripts/pnpm-workspace.mjs --filter @jiangkong/api build",
    "verify:contract-workbench": "node prisma/verify-contract-workbench.cjs",
    "preverify:trial-run": "node ../../scripts/pnpm-workspace.mjs --filter @jiangkong/api build",
    "verify:trial-run": "node prisma/verify-trial-run.cjs",
    "preverify:trial-run:preflight": "node ../../scripts/pnpm-workspace.mjs --filter @jiangkong/api build",
    "verify:trial-run:preflight": "node prisma/verify-trial-run.cjs --preflight",
    "verify:production-readiness": "node scripts/verify-production-readiness.cjs",
    "create:trial-users": "node scripts/create-trial-users.cjs",
    "contract-master:review-pack": "node scripts/generate-contract-master-review-pack.cjs",
    "pretest": "node ../../scripts/pnpm-workspace.mjs --filter @jiangkong/shared-domain build",
    "test": "jest",
    "pretypecheck": "node ../../scripts/pnpm-workspace.mjs --filter @jiangkong/shared-domain build",
    "typecheck": "tsc --noEmit",
    "prelint": "node ../../scripts/pnpm-workspace.mjs --filter @jiangkong/shared-domain build",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@jiangkong/shared-domain": "workspace:*",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@prisma/client": "^5.16.0",
    "bcryptjs": "^3.0.3",
    "docxtemplater": "^3.69.0",
    "exceljs": "^4.4.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.19.1",
    "pizzip": "^3.2.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "prisma": {
    "seed": "node prisma/seed.cjs"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/pdfkit": "^0.17.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prisma": "^5.16.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.0"
  }
}
