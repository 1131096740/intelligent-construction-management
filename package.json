{
  "name": "jiangkong",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:api": "node scripts/pnpm-workspace.mjs --filter @jiangkong/api dev",
    "dev:web": "node scripts/pnpm-workspace.mjs --filter @jiangkong/web-admin dev",
    "lint": "node scripts/pnpm-workspace.mjs -r lint",
    "test": "node scripts/pnpm-workspace.mjs -r test",
    "test:ci-orchestration": "node --test scripts/go-live-ci-gates.test.mjs scripts/inspect-contract-mutation-authority-manifest.test.mjs scripts/inspect-release-manifests.test.mjs scripts/ops/local-release-tools.test.mjs scripts/ops/run-fast-local-check.test.mjs",
    "typecheck": "node scripts/pnpm-workspace.mjs -r typecheck",
    "inspect:contract-workbench-capabilities": "node scripts/inspect-contract-workbench-capabilities.mjs --check docs/product/contract-workbench-capability-matrix.md",
    "inspect:release-manifests": "node scripts/inspect-release-manifests.mjs",
    "preinspect:whole-site-capabilities": "node scripts/pnpm-workspace.mjs --filter @jiangkong/api build",
    "inspect:whole-site-capabilities": "node scripts/inspect-whole-site-capabilities.mjs --check",
    "inspect:whole-site-web-api": "node scripts/inspect-whole-site-web-api-manifest.mjs --check",
    "preinspect:whole-site-web-api:ready": "pnpm run inspect:whole-site-capabilities",
    "inspect:whole-site-web-api:ready": "node scripts/inspect-whole-site-web-api-manifest.mjs --check --require-ready",
    "inspect:whole-site-page-actions": "node scripts/inspect-whole-site-page-action-manifest.mjs --check",
    "preinspect:whole-site-page-actions:ready": "pnpm run inspect:whole-site-web-api:ready",
    "inspect:whole-site-page-actions:ready": "node scripts/inspect-whole-site-page-action-manifest.mjs --check --require-ready",
    "inspect:whole-site-route-usage": "node scripts/inspect-whole-site-route-usage-manifest.mjs --check",
    "preinspect:whole-site-route-usage:ready": "pnpm run inspect:whole-site-web-api:ready",
    "inspect:whole-site-route-usage:ready": "node scripts/inspect-whole-site-route-usage-manifest.mjs --check --require-ready",
    "preinspect:contract-mutation-authority": "node scripts/pnpm-workspace.mjs --filter @jiangkong/api build",
    "inspect:contract-mutation-authority": "node scripts/inspect-contract-mutation-authority-manifest.mjs --check",
    "inspect:whole-site-capability-matrix": "node scripts/inspect-whole-site-capability-matrix.mjs --check",
    "check:business-language": "node scripts/check-business-language.mjs",
    "preinspect:whole-site-capability-matrix:ready": "node scripts/pnpm-workspace.mjs --filter @jiangkong/api build",
    "inspect:whole-site-capability-matrix:ready": "node scripts/inspect-whole-site-capability-matrix.mjs --check --require-ready",
    "verify:trial-run:preflight": "node services/api/prisma/verify-trial-run.cjs --preflight",
    "verify:money-bigint:local": "node scripts/pnpm-workspace.mjs --filter @jiangkong/api verify:money-bigint:local",
    "verify:project-financing-quota-concurrency:local": "node scripts/pnpm-workspace.mjs --filter @jiangkong/api verify:project-financing-quota-concurrency:local",
    "verify:settlement-approval-withdrawal-concurrency:local": "node scripts/pnpm-workspace.mjs --filter @jiangkong/api verify:settlement-approval-withdrawal-concurrency:local",
    "verify:spot-procurement-concurrency:local": "node scripts/pnpm-workspace.mjs --filter @jiangkong/api verify:spot-procurement-concurrency:local",
    "verify:payment-approval-concurrency:local": "node scripts/pnpm-workspace.mjs --filter @jiangkong/api verify:payment-approval-concurrency:local",
    "verify:contract-template-scenario-concurrency:local": "node scripts/pnpm-workspace.mjs --filter @jiangkong/api verify:contract-template-scenario-concurrency:local",
    "check:fast": "node scripts/ops/run-fast-local-check.mjs",
    "release:local": "bash scripts/ops/run-local-release-gate.sh",
    "deploy:local": "bash scripts/ops/request-github-deploy.sh",
    "deploy:mac-direct": "bash scripts/ops/deploy-from-mac.sh"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1.1.15": "1.1.18",
      "brace-expansion@2.1.1": "2.1.4",
      "body-parser@1.20.4": "1.20.6",
      "multer": "2.2.0",
      "nanoid@3.3.12": "3.3.18",
      "postcss@8.5.15": "8.5.18",
      "qs@6.14.2": "6.15.2"
    }
  }
}
