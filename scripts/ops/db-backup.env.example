# Copy to /etc/jiangkong/db-backup.env on the production server.
# Owner/mode must be root:root 600. Do not reuse the API business-file CAM account.
DB_BACKUP_COS_SECRET_ID=replace-with-dedicated-backup-cam-secret-id
DB_BACKUP_COS_SECRET_KEY=replace-with-dedicated-backup-cam-secret-key
DB_BACKUP_COS_BUCKET=jiangkong-prod-db-backups-1438687719
DB_BACKUP_COS_REGION=ap-chengdu
DB_BACKUP_COS_PREFIX=database-backups
DB_BACKUP_LOCAL_RETENTION_DAYS=7
