<view class="page">
  <view class="card detail-card">
    <view class="detail-title">{{item.businessCode || item.code || "待办单据"}}</view>
    <view class="detail-row">
      <text>项目</text>
      <text>{{item.projectName || "未关联项目"}}</text>
    </view>
    <view class="detail-row">
      <text>当前节点</text>
      <text>{{item.currentNode || item.statusLabel || "待处理"}}</text>
    </view>
    <view class="detail-row">
      <text>金额</text>
      <text>{{item.amountLabel || item.amount || "暂无数据"}}</text>
    </view>
    <view class="detail-row">
      <text>停留时间</text>
      <text>{{item.elapsedLabel || item.stayDuration || "暂无数据"}}</text>
    </view>
    <view class="next-action">{{item.nextAction || item.actionLabel || "请回到 Web 端处理完整业务动作"}}</view>
  </view>

  <view wx:if="{{canApprove}}" class="card approval-card">
    <view class="section-title">移动审批</view>
    <textarea
      class="approval-comment"
      value="{{approvalComment}}"
      placeholder="审批意见"
      bindinput="onApprovalCommentInput"
    />
    <view class="approval-actions">
      <button class="primary-button" loading="{{actionBusy === 'approve'}}" bindtap="approveItem">
        通过
      </button>
      <button class="danger-button" loading="{{actionBusy === 'reject'}}" bindtap="rejectItem">
        驳回
      </button>
    </view>
  </view>
  <view wx:elif="{{item.type === 'approval'}}" class="card muted">当前审批需回到 Web 端处理</view>
  <view wx:if="{{actionMessage}}" class="card upload-message">{{actionMessage}}</view>

  <button class="primary-button" bindtap="chooseAndUpload" loading="{{uploading}}">
    拍照上传附件
  </button>
  <view wx:if="{{uploadMessage}}" class="card upload-message">{{uploadMessage}}</view>
</view>
