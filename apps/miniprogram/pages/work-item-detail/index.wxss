.detail-card {
  display: grid;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.detail-title {
  font-size: 34rpx;
  font-weight: 700;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  color: #5f6673;
}

.detail-row text:last-child {
  color: #1f2733;
  font-weight: 600;
}

.next-action {
  padding-top: 16rpx;
  border-top: 1rpx solid #dce1e8;
  color: #165dff;
  font-weight: 600;
}

.upload-message {
  margin-top: 20rpx;
}

.approval-card {
  display: grid;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-weight: 700;
}

.approval-comment {
  width: 100%;
  min-height: 140rpx;
  padding: 18rpx;
  box-sizing: border-box;
  border: 1rpx solid #dce1e8;
  border-radius: 6rpx;
  background: #fff;
}

.approval-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.danger-button {
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 6rpx;
  color: #fff;
  background: #d92d20;
  font-size: 28rpx;
}
