{
  "name": "@jiangkong/web-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/pnpm-workspace.mjs --filter @jiangkong/shared-domain build",
    "dev": "vite",
    "prebuild": "node ../../scripts/pnpm-workspace.mjs --filter @jiangkong/shared-domain build",
    "build": "vite build",
    "preview": "vite preview",
    "pretypecheck": "node ../../scripts/pnpm-workspace.mjs --filter @jiangkong/shared-domain build",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:e2e": "tsc --project tsconfig.e2e.json",
    "pretest": "node ../../scripts/pnpm-workspace.mjs --filter @jiangkong/shared-domain build",
    "test": "vitest run",
    "test:e2e:p0": "playwright test --config playwright.config.ts",
    "test:e2e:workbench-canary": "playwright test --config playwright.workbench-canary.config.ts",
    "test:e2e:contract-detail-canary": "playwright test --config playwright.contract-detail-canary.config.ts",
    "test:e2e:handwritten-signature": "playwright test --config playwright.handwritten-signature.config.ts",
    "test:e2e:business-grid-canary": "playwright test --config playwright.business-grid-canary.config.ts",
    "prelint": "node ../../scripts/pnpm-workspace.mjs --filter @jiangkong/shared-domain build",
    "lint": "eslint src --ext .ts,.vue",
    "check:ui": "node scripts/check-ui-rules.mjs"
  },
  "dependencies": {
    "@jiangkong/shared-domain": "workspace:*",
    "@revolist/vue3-datagrid": "^4.23.22",
    "@types/qrcode": "^1.5.6",
    "pinia": "^2.1.0",
    "qrcode": "^1.5.4",
    "tdesign-vue-next": "^1.10.0",
    "vue": "^3.4.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.27.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^1.6.0",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.0.0"
  }
}
