+function withOutside289NamedProcurement(receipt, namedScope, consume) {
+  const {contract289, verifyMaterialized} = require('./checkout.cjs');
+  verifyMaterialized('/qualification/product', contract289);
+  Object.assign(receipt,{releaseTree:outsideRelease.tree,sourceBaseSha:stableRelease.sha,sourceKind:'UNCOMMITTED_EXACT_GIT_TREE'});
+  return installer(receipt,false,async context => {
+    need(context.candidateTree===outsideRelease.tree,'OWNED_289_NAMED_PROCUREMENT_SOURCE');
+    const verify = async () =>
+      assertOutsideWitness(289,JSON.parse((await context.sql(outsideWitnessSql(289))).stdout.trim()));
+    await verify();
+    await consume(context);
+    await verify();
+    receipt.sameInstancePostConsume=true;
+  },outsideRelease,namedScope);
+}
+module.exports.withOutside289GeneralProcurement = (receipt,consume) =>
+  withOutside289NamedProcurement(receipt,'procurement',consume);
+module.exports.withOutside289ProjectProcurement = (receipt,consume) =>
+  withOutside289NamedProcurement(receipt,'project',consume);
