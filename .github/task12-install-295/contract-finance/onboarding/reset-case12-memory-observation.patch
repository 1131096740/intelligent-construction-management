+function observeMemory() {
+  const read = file => {
+    try { return fs.readFileSync('/sys/fs/cgroup/'+file,'utf8').trim(); }
+    catch { return ''; }
+  };
+  const bytes = file => /^(?:max|\d{1,16})$/u.test(file) ? file : null;
+  const events = Object.fromEntries([...read('memory.events').matchAll(
+    /^(oom|oom_kill|oom_group_kill) (\d{1,12})$/gmu)].map(([,key,value])=>[key,Number(value)]));
+  return {limitBytes:bytes(read('memory.max')),peakBytes:bytes(read('memory.peak')),events};
+}
