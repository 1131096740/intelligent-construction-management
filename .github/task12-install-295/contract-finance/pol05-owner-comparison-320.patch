+// The 320 owner qualification runs its original independent source comparison
+// inside a witnessed owner session. Keep the production runtime adapter in use
+// for all point reads and business operations.
+function ownerComparisonService(client: PrismaClient) {
+  const registry = createOperatingSourceRegistry();
+  const completion = registry.require(CONTRACT_WORK_COMPLETION_SOURCE);
+  const adapters = registry.list().map(adapter => adapter !== completion ? adapter : {
+    sourceType: completion.sourceType,
+    readSourceSnapshot: completion.readSourceSnapshot.bind(completion),
+    toOperatingFactInput: completion.toOperatingFactInput.bind(completion),
+    async readProjectSnapshots(tx: Parameters<typeof completion.readProjectSnapshots>[0], projectId: string) {
+      const [proof] = await tx.$queryRaw<Array<{ sameOwner: boolean }>>`
+        SELECT session_user = 'jg_task01_owner' AND current_user = session_user
+          AND relation.relowner = session_user::regrole::oid
+          AND database.datdba = session_user::regrole::oid AS "sameOwner"
+        FROM pg_catalog.pg_class relation
+        JOIN pg_catalog.pg_database database ON database.datname = current_database()
+        WHERE relation.oid = 'public."ContractWorkCompletionFact"'::regclass
+      `;
+      assert.equal(proof?.sameOwner, true, "POL05_OWNER_COMPLETION_SOURCE_SCOPE");
+      const rows = await tx.$queryRaw<Array<{ id: string; projectId: string; costSnapshot: Prisma.InputJsonValue }>>`
+        SELECT fact.id, fact."projectId", fact."costSnapshot"
+        FROM public."ContractWorkCompletionFact" fact
+        WHERE fact."projectId" = ${projectId}::text AND fact."costSnapshot" IS NOT NULL
+        ORDER BY fact."createdAt", fact.id
+      `;
+      return rows.map(row => {
+        const sourceSnapshot = requiredJsonRecord(row.costSnapshot, "其他合同履约");
+        return {
+          projectId: row.projectId,
+          sourceType: CONTRACT_WORK_COMPLETION_SOURCE,
+          sourceBusinessId: row.id,
+          sourceVersion: 1,
+          sourceBusinessCode: requiredJsonText(sourceSnapshot, "businessCode", "其他合同履约"),
+          status: "confirmed" as const,
+          sourceSnapshot
+        };
+      });
+    }
+  });
+  return new OperatingSourceReplayService(
+    client as never,
+    new OperatingLedgerService(client as never),
+    new OperatingSourceAdapterRegistry(adapters, OPERATING_SOURCE_TYPES)
+  );
 }

