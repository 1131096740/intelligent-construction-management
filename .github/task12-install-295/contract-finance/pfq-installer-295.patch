+async function withPfq(receipt,mode,material) {
+  const current320=material!==undefined;
+  const count={'current-320':329,'text-direct-330':330,'payment-remainder-331':331,'upward-archive-332':332}[material?.mode]??295;
+  need(!current320||count>295,'PFQ_FORWARD_MODE');
+  need(receipt.purpose==='ORIGINAL_PFQ_EXACT_'+count && mode==='--pfq-'+receipt.lane+'-289-local','PFQ_295_SCOPE');
+  const pfqPositiveMode=pfqPositiveModes.includes(mode)?mode:undefined;
+  const pfqConflict=Object.hasOwn(pfqConflicts,mode)?pfqConflicts[mode]:undefined;
+  need(pfqPositiveMode || pfqConflict || mode==='--pfq-app-289-local','PFQ_EXACT_289_MODE');
+  const consume=async context=>{
+    need(context.candidateTree===(current320?material.sourceTree:require('./scope.json').tree)&&receipt.orderedTails?.at(-1)?.size===295,'PFQ_EXACT_295_CONTEXT');
+    if(mode==='--pfq-app-289-local')await require('./workspace/services/api/prisma/task12-pfq-app.cjs').runPfqApp(context,receipt);
+    else if(pfqConflict){
+      const observed=receipt.pfqRecovery;
+      need(observed?.kind===pfqConflict&&observed.markerInPostgres&&
+        observed.PrismaResolve===true&&observed.originalRowPreserved&&observed.historicalNull&&
+        (pfqConflict==='duplicate'||observed.caseSpecificBindingConfirmed&&observed.caseSpecificBindingCleared),
+        'PFQ_RECOVERY_COMPLETION');
+    }else{
+      const fixture=require(pfqPositiveFixtures)[pfqPositiveMode];
+      need((await context.sql(fixture.readback)).stdout.trim()===fixture.expected,'PFQ_EXACT_RETAINED_VALUE');
+      if(fixture.immutable){
+        const proof=await context.sql(`DO $pfq$ BEGIN
+          BEGIN
+            ${fixture.immutable}
+            RAISE EXCEPTION 'PFQ_IMMUTABILITY_NOT_ENFORCED';
+          EXCEPTION WHEN check_violation THEN
+            IF SQLERRM <> 'project financing quota termination facts are immutable' THEN RAISE; END IF;
+          END;
+        END $pfq$;
+        ${fixture.readback}`);
+        need(proof.stdout.trim()===fixture.expected,'PFQ_IMMUTABLE_RETAINED_VALUE');
+      }
+      receipt.pfqPositive={mode:pfqPositiveMode,prefix:fixture.prefix,exactOriginalValues:true,
+        ...(fixture.immutable&&{immutable:true})};
+    }
+    assertOutsideWitness(289,JSON.parse((await context.sql(outsideWitnessSql(289,current320,count===332))).stdout.trim()));
+    receipt.pfqPostconsume={count,exactB7:true};
+  };
+  const install=count===332?module.exports.withCombined332UpwardArchive:
+    count===331?module.exports.withCombined331PaymentRemainder:
+    count===330?module.exports.withCombined330TextAgreement:module.exports.withCombined320ContractPayment;
+  return current320
+    ? install(receipt,consume,material)
+    : module.exports.withCombined295MultiWitness(receipt,consume);
+}
+module.exports.withPfq295=(receipt,mode)=>withPfq(receipt,mode);
+module.exports.withPfq320=(receipt,mode,material)=>withPfq(receipt,mode,material);
