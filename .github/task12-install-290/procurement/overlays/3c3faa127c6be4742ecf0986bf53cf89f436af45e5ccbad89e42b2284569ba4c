"use strict";

const { randomUUID, createHash } = require("node:crypto");
const { spawnSync } = require("node:child_process");
const { existsSync, readFileSync, mkdirSync, realpathSync } = require("node:fs");
const path = require("node:path");
const { tables } = require("./task398-owned-280-business-read-baseline.json");
const { collision_routines: originalRegistry } = require("./local-staged-migration-qualification.json");

const scopes = Object.freeze({
  procurement: {
    role: "general_procurement_runtime",
    specs: [
      ["general-procurement-http-postgres.spec.ts", 15],
      ["approval-v6-migration-postgres.spec.ts", 1],
    ],
    flags: ["RUN_GENERAL_PROCUREMENT_PG16", "RUN_GENERAL_PROCUREMENT_BROWSER"],
  },
  project: {
    role: "project_business_scope_runtime",
    specs: [["project-business-scope-http-postgres.spec.ts", 11]],
    flags: ["RUN_PROJECT_BUSINESS_SCOPE_PG16", "RUN_PROJECT_BUSINESS_SCOPE_BROWSER"],
  },
});
const registry = Object.freeze([
  ...Object.keys(originalRegistry).filter(signature =>
    /^public\.jg_(?:has_exclusive_file_business_binding\(pg_catalog\.text\)|file_business_(?:collision_columns|binding_columns(?:_before_[a-z0-9_]+)?)\(\))$/u.test(signature)),
  "public.jg_file_business_binding_columns_before_contract_archive_v2()",
  "public.jg_file_business_binding_columns_before_owner_settlement()",
  "public.jg_file_business_binding_columns_before_signed_settlement()",
]);
const noRuntimeRead = new Set(["OperatingLedgerWriteSecret", "OperatingLedgerWriteContext", "ProjectOwnerSettlementEntry"]);
const noRuntimeWrite = new Set(["OperatingFact", "OperatingImpactEntry", "ProjectParticipatingCompanyMutationFence"]);
const readable = tables.filter(table=>!noRuntimeRead.has(table));
const writable = readable.filter(table=>!noRuntimeWrite.has(table));
const list = values=>values.map(value=>"'"+value+"'").join(",");

function profile(scope) {
  if (!Object.hasOwn(scopes,scope)) throw new Error("PROCUREMENT_OWNED_SCOPE");
  return scopes[scope];
}
function databaseIdentity(database) {
  if (!/^jg_task01_[a-f0-9]{32}$/u.test(database)) throw new Error("PROCUREMENT_OWNED_DATABASE");
}

function roleSetup(scope, database, password) {
  const {role} = profile(scope);
  databaseIdentity(database);
  if (!/^[a-f0-9-]{36}$/u.test(password)) throw new Error("PROCUREMENT_OWNED_PASSWORD_SHAPE");
  const source = readFileSync(path.join(__dirname,"general-procurement-runtime-grants.sql"),"utf8");
  const deploymentGrants = source.slice(source.indexOf("DO $$"),source.indexOf("COMMIT;"));
  if (!deploymentGrants.startsWith("DO $$") || !deploymentGrants.trimEnd().endsWith("$$;")) {
    throw new Error("PROCUREMENT_OWNED_GRANT_MATERIAL");
  }
  return `
BEGIN;
DO $owned_preimage$
BEGIN
  IF current_database()<>'${database}' OR current_user<>'jg_task01_owner' OR current_user<>session_user
    OR current_user::regrole::oid<>10 OR NOT EXISTS(
      SELECT FROM pg_database WHERE datname=current_database() AND datdba=10)
    OR NOT EXISTS(SELECT FROM pg_stat_ssl WHERE pid=pg_backend_pid() AND ssl)
    OR EXISTS(SELECT FROM pg_roles WHERE rolname IN ('general_procurement_runtime','project_business_scope_runtime'))
  THEN RAISE EXCEPTION 'PROCUREMENT_OWNED_PREIMAGE'; END IF;
END;
$owned_preimage$;
CREATE ROLE ${role} LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS NOINHERIT PASSWORD '${password}';
GRANT CONNECT${scope==="procurement"?", TEMPORARY":""} ON DATABASE ${database} TO ${role};
GRANT USAGE ON SCHEMA public TO ${role};
DO $owned_access$
DECLARE relation name; routine text;
BEGIN
  FOR relation IN SELECT tablename FROM pg_catalog.pg_tables WHERE schemaname='public'
    AND tablename IN (${list(readable)})
  LOOP EXECUTE format('GRANT SELECT ON TABLE public.%I TO %I',relation,'${role}'); END LOOP;
  FOR relation IN SELECT tablename FROM pg_catalog.pg_tables WHERE schemaname='public'
    AND tablename IN (${list(writable)})
  LOOP EXECUTE format('GRANT INSERT,UPDATE,DELETE ON TABLE public.%I TO %I',relation,'${role}'); END LOOP;

  FOREACH routine IN ARRAY ARRAY[${list(registry)}] LOOP
    IF NOT EXISTS(SELECT FROM pg_proc p WHERE p.oid=to_regprocedure(routine) AND p.proowner=10
      AND p.pronamespace=to_regnamespace('public') AND p.prokind='f' AND NOT p.prosecdef
      AND NOT EXISTS(SELECT FROM aclexplode(coalesce(p.proacl,acldefault('f',p.proowner))) a WHERE a.grantee=0))
    THEN RAISE EXCEPTION 'PROCUREMENT_OWNED_FILE_GUARD_PREIMAGE'; END IF;
    EXECUTE format('GRANT EXECUTE ON FUNCTION %s TO %I',routine,'${role}');
  END LOOP;
END;
$owned_access$;
${scope==="procurement"?`DO $owned_registered_metadata$
DECLARE registry_oid oid := to_regprocedure('public.jg_file_business_binding_columns_before_registered_payment()');
BEGIN
  IF NOT EXISTS(SELECT FROM pg_proc p JOIN pg_language l ON l.oid=p.prolang
    WHERE p.oid=registry_oid AND p.proowner=10 AND p.pronamespace=to_regnamespace('public')
      AND NOT p.prosecdef AND p.prokind='f' AND p.proretset AND p.provolatile='s'
      AND p.proparallel='s' AND NOT p.proisstrict AND l.lanname='sql'
      AND p.proconfig=ARRAY['search_path=pg_catalog, public, pg_temp']
      AND encode(sha256(convert_to(p.prosrc,'UTF8')),'hex')='d2a3171b76def6792d43f5cc37ede636f0f25e57b4dcf25625d3e4c91471080f'
      AND NOT EXISTS(SELECT FROM aclexplode(coalesce(p.proacl,acldefault('f',p.proowner))) a WHERE a.grantee=0))
    OR has_function_privilege('general_procurement_runtime',registry_oid,'EXECUTE')
  THEN RAISE EXCEPTION 'PROCUREMENT_OWNED_METADATA_PREIMAGE'; END IF;
  GRANT EXECUTE ON FUNCTION public.jg_file_business_binding_columns_before_registered_payment() TO general_procurement_runtime;
  IF NOT has_function_privilege('general_procurement_runtime',registry_oid,'EXECUTE')
    OR has_function_privilege('general_procurement_runtime',registry_oid,'EXECUTE WITH GRANT OPTION')
    OR has_function_privilege('general_procurement_runtime','public.jg_project_owner_settlement_voucher_bound(text)','EXECUTE')
  THEN RAISE EXCEPTION 'PROCUREMENT_OWNED_METADATA_POSTIMAGE'; END IF;
END;
$owned_registered_metadata$;`:""}
SELECT set_config('app.procurement_runtime_role','${role}',true);
${deploymentGrants}
DO $owned_postimage$
BEGIN
  IF has_function_privilege('${role}','public.jg_project_owner_settlement_voucher_bound(text)','EXECUTE')
    OR has_any_column_privilege('${role}','public._prisma_migrations','SELECT,INSERT,UPDATE,REFERENCES')
    OR has_table_privilege('${role}','public._prisma_migrations','DELETE,TRUNCATE')
    OR EXISTS(
      SELECT FROM pg_class c WHERE c.relnamespace=to_regnamespace('public') AND c.relkind IN ('r','p')
        AND c.relname NOT IN (${list(readable)})
        AND (has_any_column_privilege('${role}',c.oid,'SELECT,INSERT,UPDATE,REFERENCES')
          OR has_table_privilege('${role}',c.oid,'DELETE,TRUNCATE')))
  THEN RAISE EXCEPTION 'PROCUREMENT_OWNED_PRIVATE_AUTHORITIES'; END IF;
END;
$owned_postimage$;
ALTER DATABASE ${database} SET jg.procurement_run_id='${database.slice("jg_task01_".length)}';
COMMIT;
`;
}

function roleTeardown(scope,database) {
  const {role}=profile(scope);
  databaseIdentity(database);
  return `
BEGIN;
DO $owned_release$
BEGIN
  IF current_database()<>'${database}' OR current_user<>'jg_task01_owner' OR current_user<>session_user
    OR current_user::regrole::oid<>10
    OR EXISTS(SELECT FROM pg_stat_activity WHERE usename='${role}')
    OR EXISTS(SELECT FROM pg_auth_members WHERE '${role}'::regrole::oid IN (member,roleid))
    OR EXISTS(
      SELECT FROM pg_shdepend WHERE refclassid='pg_authid'::regclass
        AND refobjid='${role}'::regrole::oid AND deptype='o')
  THEN RAISE EXCEPTION 'PROCUREMENT_OWNED_ROLE_STILL_IN_USE'; END IF;
END;
$owned_release$;
REVOKE CONNECT${scope==="procurement"?", TEMPORARY":""} ON DATABASE ${database} FROM ${role};
 ${scope==="procurement"?"REVOKE EXECUTE ON FUNCTION public.jg_file_business_binding_columns_before_registered_payment() FROM general_procurement_runtime;":""}
DROP OWNED BY ${role};
DROP ROLE ${role};
ALTER DATABASE ${database} RESET jg.procurement_run_id;
SELECT public.jg_require_contract_direct_upward_source_v2();
COMMIT;
`;
}

async function verify(scope,context) {
  const {role,specs,flags}=profile(scope);
  const {database,runId,workDir,browserWebRoot}=context;
  databaseIdentity(database);
  const runtime=new URL(context.ownerUrl);
  if (database!=="jg_task01_"+runId.replaceAll("-","") ||
      runtime.protocol!=="postgresql:" || runtime.hostname!=="127.0.0.1" ||
      runtime.username!=="jg_task01_owner" || runtime.pathname!=="/"+database ||
      runtime.searchParams.get("sslmode")!=="require" || runtime.searchParams.get("sslaccept")!=="strict" ||
      runtime.searchParams.get("sslcert")!==path.join(workDir,"ca.crt") ||
      browserWebRoot!==path.join(workDir,"web-admin") || realpathSync(browserWebRoot)!==browserWebRoot) {
    throw new Error("PROCUREMENT_OWNED_RUN_CONTEXT");
  }
  const password=randomUUID();
  await context.sql(roleSetup(scope,database,password));
  runtime.username=role;
  runtime.password=password;
  if (scope==="procurement") {
    // The original procurement DB used Prisma's default pool. Its self-review takes
    // a second connection for password confirmation while the transaction is open.
    if (runtime.searchParams.get("connection_limit")!=="1") throw new Error("PROCUREMENT_OWNED_POOL_PREIMAGE");
    runtime.searchParams.set("connection_limit","2");
  }
  const storage=path.join(workDir,"procurement-files");
  mkdirSync(storage,{mode:0o700});
  const env={
    PATH:"/usr/local/bin:/usr/bin:/bin", HOME:workDir, TMPDIR:workDir, COREPACK_HOME:"/opt/corepack",
    COREPACK_ENABLE_NETWORK:"0", COREPACK_DEFAULT_TO_LATEST:"0", NODE_ENV:"test", CI:"true",
    DATABASE_URL:runtime.toString(), FILE_STORAGE_DRIVER:"local", FILE_STORAGE_ROOT:storage,
    INITIAL_USER_TEMPORARY_PASSWORD:"Local-Initial-Only-01", SMS_ENABLED:"false",
    PLAYWRIGHT_BROWSERS_PATH:"/opt/jg-playwright", JG_PROCUREMENT_OWNED_WEB_ROOT:browserWebRoot,
    JG_PROCUREMENT_OWNED_RUN_ID:runId, JG_TASK12_OWNED_280_RUN_ID:runId, JG_PROCUREMENT_OWNED_SCOPE:scope,
    ...Object.fromEntries(flags.map(flag=>[flag,"1"])),
    ...(scope==="project"?{PROJECT_BUSINESS_SCOPE_FIXTURE_DATABASE_URL:context.ownerUrl,SPOT_PROCUREMENT_PILOT_PROJECT_IDS:"*"}:{}),
  };
  const report=path.join(workDir,"procurement-jest.json");
  const args=["--filter","@jiangkong/api","exec","jest","--runInBand","--runTestsByPath",
    ...specs.map(([file])=>"src/database/"+file),"--json","--outputFile",report];
  const child=spawnSync("pnpm",args,{
    cwd:"/qualification/workspace",env,encoding:"utf8",timeout:300_000,maxBuffer:8*1024*1024,
  });
  if (child.status!==0||child.error){
    const outcome=existsSync(report)?JSON.parse(readFileSync(report,"utf8")):undefined;
    const failed=outcome?.testResults.flatMap(suite=>suite.assertionResults).find(test=>test.status==="failed");
    const output=[...(failed?.failureMessages??[]),child.stderr??"",child.stdout??""].join("\n")
      .replace(/\x1b\[[0-9;]*m/gu,"");
    const denied=/permission denied for (function|table|relation|schema) ([A-Za-z0-9_."]{1,100})/u.exec(output);
    const status=/(?:状态码|[Hh][Tt][Tt][Pp] status|Received)[:： ]+([1-5][0-9]{2})/u.exec(output)?.[1];
    const frame=/(?:general-procurement-http-postgres|project-business-scope-http-postgres|approval-v6-migration-postgres)\.spec\.ts:(\d+):(\d+)/u.exec(output);
    const kind=/Target crashed/u.test(output)?"BROWSER_TARGET_CRASH":
      /net::ERR_ABORTED/u.test(output)?"BROWSER_NAVIGATION_ABORT":
      /Cannot find module|MODULE_NOT_FOUND/u.test(output)?"MODULE_NOT_FOUND":
      /Timeout|timeout/u.test(output)?"TIMEOUT":undefined;
    throw Object.assign(new Error("PROCUREMENT_OWNED_JEST_FAILED"),{
      exit:child.status,signal:child.signal,executionError:child.error?.code,kind,
      sqlstate:/\b(?:code|SQLSTATE)\W+([0-9A-Z]{5})\b/u.exec(output)?.[1],
      prismaCode:/\bP[0-9]{4}\b/u.exec(output)?.[0],
      denied:denied?{kind:denied[1],object:denied[2].replace(/"$/u,"")}:undefined,
      httpStatus:status?Number(status):undefined,frame:frame?[Number(frame[1]),Number(frame[2])]:undefined,
      failedTest:failed?createHash("sha256").update(failed.fullName).digest("hex"):undefined,
    });
  }
  const outcome=JSON.parse(readFileSync(report,"utf8"));
  if (outcome.success!==true||outcome.numPendingTests!==0||outcome.numPassedTestSuites!==specs.length||
      outcome.numTotalTestSuites!==specs.length||!specs.every(([file,count])=>{
        const suite=outcome.testResults.find(result=>result.name==="/qualification/workspace/services/api/src/database/"+file);
        return suite?.status==="passed"&&suite.assertionResults.length===count&&suite.assertionResults.every(test=>test.status==="passed");
      }))throw new Error("PROCUREMENT_OWNED_JEST_COVERAGE");

  await context.sql(roleTeardown(scope,database));
  return {scope,role,tests:specs.map(([file,count])=>({file,passed:count})),
    reportSha256:createHash("sha256").update(readFileSync(report)).digest("hex")};
}

module.exports={verify,roleSetup,roleTeardown};
