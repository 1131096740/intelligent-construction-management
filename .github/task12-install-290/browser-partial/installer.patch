+module.exports.withOutside290InstallOnly = receipt => {
+  const {contract289, verifyMaterialized}=require('./checkout.cjs');
+  verifyMaterialized('/qualification/product',contract289);
+  const {scope,verifySql}=require('./successor.cjs');
+  verifySql('/qualification/successor.sql');
+  Object.assign(receipt,{releaseTree:scope.tree,predecessorTree:outsideRelease.tree,sourceBaseSha:stableRelease.sha,sourceKind:'UNCOMMITTED_EXACT_GIT_TREE'});
+  return installer(receipt,false,undefined,outsideRelease,installOnly290);
+};
+
