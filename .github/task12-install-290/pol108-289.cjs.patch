+            sqlstates:[...message.matchAll(/\b(?:SQLSTATE|Code:)\s*[`']?([0-9A-Z]{5})\b/gu)].slice(0, 4).map(row=>row[1]),
+            frames:[...message.matchAll(/operating-projection-postgresql\.cases\.ts:(\d+):(\d+)/gu)]
